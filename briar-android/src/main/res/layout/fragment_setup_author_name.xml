<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_zerion_gradient"
    tools:context=".android.setup.SetupNicknameFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="36dp">

            <!-- Zerion logo -->
            <ImageView
                android:id="@+id/logo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/splash_screen"
                android:importantForAccessibility="no"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Title -->
            <TextView
                android:id="@+id/intro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_title"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@+id/logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/subtext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Choose a display name. This will be visible to your contacts."
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/intro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Nickname Input (transparent field) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nickname_entry_wrapper"
                style="@style/Zerion.TextInput.Transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:hint="@string/choose_nickname"
                app:errorEnabled="true"
                app:layout_constraintTop_toBottomOf="@+id/subtext"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nickname_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="flagNoPersonalizedLearning|actionNext"
                    android:inputType="text|textCapWords"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textColorHint="#80FFFFFF"
                    android:importantForAutofill="no" />

                <requestFocus />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Info Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/info_button"
                style="@style/Zerion.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/more_info"
                app:icon="@drawable/ic_info_white"
                app:iconTint="@color/zerion_cyan"
                app:iconPadding="8dp"
                app:layout_constraintTop_toBottomOf="@+id/nickname_entry_wrapper"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp" />

            <!-- Continue Button (transparent with border) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/next"
                style="@style/Zerion.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/setup_next"
                app:layout_constraintTop_toBottomOf="@+id/info_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:enabled="true" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</FrameLayout>
