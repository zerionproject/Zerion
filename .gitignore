# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
/release/
**/output-metadata.json

# Gradle files
.gradle/
build/

# Local configuration file
local.properties

# Log Files
*.log

# Android Studio
*.iml
.idea/
captures/
.externalNativeBuild
.cxx/

# Keystore files
*.jks
*.keystore
keystore.properties

# OS-specific files
.DS_Store
Thumbs.db
nul

# IDE/Editor directories
.vs/
.vscode/

.claude/

# Pentest and security audit data (sensitive)
PentestZerion/
docs/SECURITY_AUDIT_REPORT.md
scripts/run-security-audit.*

# Generated Tor binaries (extracted from dependencies during build)
zerion-core-android/src/main/jniLibs/
docs-internal/

# Local-only validator / testing harness — keep off the public repo
scripts/android_validators/
scripts/protocol_validators/
scripts/*_validators/


# Native libraries are built from source, never committed (F-Droid requires
# every binary to be buildable from source). Produced into jniLibs by the
# reproducible build: libzmonero.so via packaging/monero-android (pinned
# Monero), libpayjoin_ffi.so via zerion-android/native/payjoin. The
# verify-*-native.gradle gates fail the build if a shipped ABI is missing.
zerion-android/src/main/jniLibs/*/libzmonero.so
zerion-android/src/main/jniLibs/*/libpayjoin_ffi.so
# Orphaned desktop binaries (the desktop app lives in the Zerion-Desktop repo)
zerion-desktop-ui/appResources/*/monero/monero-wallet-rpc
zerion-desktop-ui/appResources/*/monero/monero-wallet-rpc.exe
# Signing sidecar artifacts
*.idsig
