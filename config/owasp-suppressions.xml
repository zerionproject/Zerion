<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
	<!--
		Add an entry here for each known false-positive flagged by
		./gradlew dependencyCheckAggregate. Format:

		<suppress until="YYYY-MM-DD">
			<notes>Brief justification, e.g. "Tor dep flagged for old Java
			XML library CVE that is unreachable in our usage."</notes>
			<gav regex="true">^org\.example:.*:.*$</gav>
			<cve>CVE-2023-XXXXX</cve>
		</suppress>

		Keep this file under version control so dismissals are reviewable.
		Suppressions should always have a written reason and ideally an
		expiration ("until") date forcing periodic re-review.
	-->
</suppressions>
