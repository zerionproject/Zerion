<?xml version="1.0" encoding="utf-8"?>
<resources>
	<color name="zerion_primary">@color/zerion_night_800</color>
	<!-- Commit to the cyan brand accent in night mode too (was lime, which gave
	     OS dark mode a different, greenish identity). -->
	<color name="zerion_accent">@color/zerion_cyan</color>

	<color name="preference_category_background">@color/zerion_night_950</color>

	<color name="color_primary">@android:color/white</color>

	<color name="msg_in">@color/zerion_night_700</color>
	<color name="msg_out">@color/zerion_blue_600</color>
	<color name="notice_in">@color/zerion_night_800</color>
	<color name="notice_out">@color/zerion_blue_800</color>
	<color name="msg_stroke">@color/msg_stroke_dark</color>

	<!-- Ensure outgoing message bubbles are visible in dark mode -->
	<color name="zerion_message_sent">#0099CC</color>
	<color name="zerion_message_sent_pressed">#0077AA</color>
	<color name="zerion_message_received">#2C2D32</color>
	<color name="zerion_message_received_pressed">#353640</color>

	<color name="window_background">@color/zerion_night_950</color>
	<color name="card_background">@color/zerion_night_800</color>
	<color name="item_background_highlight">@color/zerion_night_700</color>

	<color name="zerion_button_text_neutral">@color/zerion_blue_400</color>
	<color name="zerion_button_text_disabled">#23cccccc</color>

	<color name="thread_indicator">@color/zerion_night_700</color>
	<color name="thread_item_highlight">@android:color/black</color>

	<color name="divider">@android:color/black</color>

	<color name="il_border">#64748B</color>
	<color name="il_background">#334155</color>
	<color name="il_lime">@color/zerion_success</color>
	<color name="il_orange">@color/zerion_orange_400</color>
	<color name="il_red">@color/zerion_destructive</color>

	<color name="md_theme_tertiary">@color/zerion_blue_400</color>
	<color name="md_theme_onTertiary">@color/zerion_blue_900</color>
	<color name="md_theme_tertiaryContainer">@color/zerion_blue_800</color>
	<color name="md_theme_onTertiaryContainer">@color/zerion_blue_300</color>
	<!-- Cool white to match the default dark identity (was a warm off-white
	     that clashed with the pure-white text used elsewhere). -->
	<color name="md_theme_onBackground">#FFFFFF</color>
	<color name="md_theme_onSurface">#FFFFFF</color>
	<color name="md_theme_surfaceDim">@color/zerion_night_700</color>
	<color name="md_theme_error">@color/zerion_red_400</color>
</resources>
