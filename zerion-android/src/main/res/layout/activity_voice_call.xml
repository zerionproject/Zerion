<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Remote Video Surface (center-crop container) -->
    <FrameLayout
        android:id="@+id/remote_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:visibility="gone">

        <TextureView
            android:id="@+id/remote_video_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Local Video Preview (PIP corner) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/local_video_container"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextureView
            android:id="@+id/local_video_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <!-- Call Type Label at Top -->
    <TextView
        android:id="@+id/call_type_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/zerion_call"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contact Avatar - Large Centered Circle -->
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/call_type_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/contact_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_person_white_48dp"
            android:background="@drawable/bg_avatar_circle_large"
            android:padding="32dp"
            android:scaleType="centerInside"
            android:importantForAccessibility="no" />

    </FrameLayout>

    <!-- Contact Name -->
    <TextView
        android:id="@+id/contact_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginHorizontal="32dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="0.005"
        app:layout_constraintTop_toBottomOf="@id/avatar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Contact Name" />

    <!-- Call Status -->
    <TextView
        android:id="@+id/call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/call_connecting"
        android:textColor="?android:attr/textColorTertiary"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/contact_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call Duration Timer -->
    <Chronometer
        android:id="@+id/call_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/call_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Network Quality Indicators (shown during active call) -->
    <LinearLayout
        android:id="@+id/network_quality_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:padding="8dp"
        android:background="@drawable/bg_network_quality"
        app:layout_constraintTop_toBottomOf="@id/call_duration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/signal_strength_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_signal_3"
            android:importantForAccessibility="no"
            app:tint="@color/zerion_lime_500" />

        <TextView
            android:id="@+id/latency_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="@color/zerion_lime_500"
            tools:text="120ms" />

        <TextView
            android:id="@+id/packet_loss_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textColor="@color/zerion_orange_500"
            android:visibility="gone"
            tools:text="Loss: 2%" />

        <TextView
            android:id="@+id/codec_bitrate_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            tools:text="Opus 16kbps"
            android:textColor="?android:attr/textColorTertiary" />

    </LinearLayout>

    <!-- Incoming Call Layout - Professional Molly Style -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/incoming_call_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Decline Button with Label -->
        <LinearLayout
            android:id="@+id/decline_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/accept_container"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/decline_call_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_call_end_white"
                android:contentDescription="@string/call_action_decline"
                android:backgroundTint="@color/zerion_destructive"
                app:fabCustomSize="72dp"
                app:maxImageSize="32dp"
                app:tint="@android:color/white"
                app:elevation="6dp" />

            <TextView
                android:id="@+id/decline_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/decline"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Accept Button with Label -->
        <LinearLayout
            android:id="@+id/accept_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/decline_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/accept_call_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_phone_white"
                android:contentDescription="@string/call_action_accept"
                android:backgroundTint="@color/zerion_success"
                app:fabCustomSize="72dp"
                app:maxImageSize="32dp"
                app:tint="@android:color/white"
                app:elevation="6dp" />

            <TextView
                android:id="@+id/accept_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/accept"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Active Call Layout -->
    <LinearLayout
        android:id="@+id/active_call_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Call Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <!-- Mute Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="24dp">

                <ImageButton
                    android:id="@+id/mute_button"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_mic_white"
                    android:contentDescription="@string/call_action_mute"
                    android:background="@drawable/bg_call_control_button"
                    android:padding="16dp"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/mute_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mute"
                    android:textColor="?android:attr/textColorTertiary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Speaker Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="24dp">

                <ImageButton
                    android:id="@+id/speaker_button"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_volume_down_white"
                    android:contentDescription="@string/call_action_speaker_on"
                    android:background="@drawable/bg_call_control_button"
                    android:padding="16dp"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/speaker_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/speaker"
                    android:textColor="?android:attr/textColorTertiary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Video Button -->
            <LinearLayout
                android:id="@+id/video_button_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="24dp">

                <ImageButton
                    android:id="@+id/video_button"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_videocam"
                    android:contentDescription="@string/call_action_video_on"
                    android:background="@drawable/bg_call_control_button"
                    android:padding="16dp"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/video_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/video"
                    android:textColor="?android:attr/textColorTertiary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Switch Camera Button (only visible when video active) -->
            <LinearLayout
                android:id="@+id/switch_camera_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="24dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/switch_camera_button"
                    android:contentDescription="@string/call_action_switch_camera"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_switch_camera"
                    android:background="@drawable/bg_call_control_button"
                    android:padding="16dp"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/switch_camera_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/switch_camera"
                    android:textColor="?android:attr/textColorTertiary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- End Call Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/end_call_button"
                android:contentDescription="@string/call_action_end"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_call_end_white"
                android:backgroundTint="@color/zerion_destructive"
                app:fabCustomSize="72dp"
                app:maxImageSize="32dp"
                app:tint="@android:color/white"
                app:elevation="6dp" />

            <TextView
                android:id="@+id/end_call_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/end_call"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
