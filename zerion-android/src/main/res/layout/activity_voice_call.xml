<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Call Type Label at Top -->
    <TextView
        android:id="@+id/call_type_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/zerion_call"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contact Avatar - Large Centered Circle -->
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/call_type_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/contact_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_person_white_48dp"
            android:background="@drawable/bg_avatar_circle_large"
            android:padding="32dp"
            android:scaleType="centerInside" />

    </FrameLayout>

    <!-- Contact Name -->
    <TextView
        android:id="@+id/contact_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Contact Name"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/avatar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call Status -->
    <TextView
        android:id="@+id/call_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/call_connecting"
        android:textColor="#888888"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/contact_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call Duration Timer -->
    <Chronometer
        android:id="@+id/call_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/call_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Network Quality Indicators (shown during active call) -->
    <LinearLayout
        android:id="@+id/network_quality_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:padding="8dp"
        android:background="@drawable/bg_network_quality"
        app:layout_constraintTop_toBottomOf="@id/call_duration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/signal_strength_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_signal_3"
            app:tint="@color/briar_lime_500" />

        <TextView
            android:id="@+id/latency_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="120ms"
            android:textSize="12sp"
            android:textColor="@color/briar_lime_500" />

        <TextView
            android:id="@+id/packet_loss_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Loss: 2%"
            android:textSize="12sp"
            android:textColor="@color/briar_orange_500"
            android:visibility="gone" />

        <TextView
            android:id="@+id/codec_bitrate_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Opus 16kbps"
            android:textSize="12sp"
            android:textColor="#888888" />

    </LinearLayout>

    <!-- Incoming Call Layout - Professional Molly Style -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/incoming_call_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Decline Button with Label -->
        <LinearLayout
            android:id="@+id/decline_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/accept_container"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/decline_call_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_call_end_white"
                android:backgroundTint="#E53935"
                app:fabCustomSize="72dp"
                app:maxImageSize="32dp"
                app:tint="@android:color/white"
                app:elevation="6dp" />

            <TextView
                android:id="@+id/decline_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/decline"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Accept Button with Label -->
        <LinearLayout
            android:id="@+id/accept_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/decline_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/accept_call_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_phone_white"
                android:backgroundTint="#4CAF50"
                app:fabCustomSize="72dp"
                app:maxImageSize="32dp"
                app:tint="@android:color/white"
                app:elevation="6dp" />

            <TextView
                android:id="@+id/accept_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/accept"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Active Call Layout -->
    <LinearLayout
        android:id="@+id/active_call_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Call Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <!-- Mute Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="24dp">

                <ImageButton
                    android:id="@+id/mute_button"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_mic_white"
                    android:background="@drawable/bg_call_control_button"
                    android:padding="16dp"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/mute_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/mute"
                    android:textColor="#888888"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Speaker Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="24dp">

                <ImageButton
                    android:id="@+id/speaker_button"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_volume_down_white"
                    android:background="@drawable/bg_call_control_button"
                    android:padding="16dp"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/speaker_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/speaker"
                    android:textColor="#888888"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- End Call Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/end_call_button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_call_end_white"
                android:backgroundTint="#E53935"
                app:fabCustomSize="72dp"
                app:maxImageSize="32dp"
                app:tint="@android:color/white"
                app:elevation="6dp" />

            <TextView
                android:id="@+id/end_call_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/end_call"
                android:textColor="#AAAAAA"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
