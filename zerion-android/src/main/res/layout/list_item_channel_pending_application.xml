<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:paddingStart="16dp"
	android:paddingEnd="16dp"
	android:paddingTop="12dp"
	android:paddingBottom="12dp">

	<com.google.android.material.imageview.ShapeableImageView

		app:shapeAppearanceOverlay="@style/ShapeAppearance.Zerion.Circle"
		android:id="@+id/applicantAvatar"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_marginEnd="14dp"
		android:src="@drawable/ic_person"
		app:tint="?attr/zerionColorOnSurfaceMuted" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/applicantName"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textColor="?attr/zerionColorOnSurface"
			tools:text="Alice"
			android:textAppearance="@style/TextAppearance.Zerion.Body" />

		<TextView
			android:id="@+id/applicantSubtitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textColor="?attr/zerionColorOnSurfaceMuted"
			tools:text="abcd1234…"
			android:textAppearance="@style/TextAppearance.Zerion.Caption" />

	</LinearLayout>

	<com.google.android.material.button.MaterialButton
		android:id="@+id/applicantDenyButton"
		style="@style/Widget.MaterialComponents.Button.TextButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="4dp"
		android:minWidth="0dp"
		android:text="@string/channels_pending_deny"
		android:textColor="?attr/zerionColorAccentText"
		android:textAppearance="@style/TextAppearance.Zerion.Label" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/applicantApproveButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:minWidth="0dp"
		android:text="@string/channels_pending_approve"
		android:textAppearance="@style/TextAppearance.Zerion.Label" />

</LinearLayout>
