<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:minHeight="48dp"
	android:layout_marginTop="2dp"
	android:layout_marginBottom="2dp"
	android:orientation="vertical">

	<TextView
		android:id="@+id/senderName"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="14dp"
		android:layout_marginBottom="-6dp"
		android:paddingTop="8dp"
		android:paddingBottom="8dp"
		android:textColor="@color/zerion_accent_text"
		android:textSize="12sp"
		android:textStyle="bold"
		tools:text="Alice" />

	<androidx.constraintlayout.widget.ConstraintLayout
		android:id="@+id/bubble"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="48dp"
		android:background="@drawable/msg_in"
		android:elevation="@dimen/message_bubble_elevation"
		android:paddingHorizontal="12dp"
		android:paddingVertical="8dp">

		<LinearLayout
			android:id="@+id/quoteBlock"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="4dp"
			android:background="@drawable/bg_reply_quote_in"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?android:attr/selectableItemBackground"
			android:minWidth="@dimen/reply_quote_min_width"
			android:minHeight="48dp"
			android:orientation="horizontal"
			android:visibility="gone"
			app:layout_constrainedWidth="true"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			tools:visibility="visible">

			<View
				android:layout_width="3dp"
				android:layout_height="match_parent"
				android:background="@color/zerion_primary_accent" />

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:orientation="vertical"
				android:paddingStart="8dp"
				android:paddingTop="4dp"
				android:paddingEnd="8dp"
				android:paddingBottom="6dp">

				<TextView
					android:id="@+id/quoteAuthor"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxLines="1"
					android:textColor="@color/zerion_primary_accent"
					android:textSize="12sp"
					android:textStyle="bold"
					tools:text="Bob" />

				<TextView
					android:id="@+id/quoteText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxWidth="244dp"
					android:maxLines="1"
					android:textColor="@color/zerion_text_secondary_inverse"
					android:textSize="13sp"
					tools:text="Quoted post" />

			</LinearLayout>

		</LinearLayout>

		<TextView
			android:id="@+id/postText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:maxWidth="260dp"
			android:textColor="@color/zerion_text_primary_inverse"
			android:textSize="15sp"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/quoteBlock"
			tools:text="Hello group" />

		<TextView
			android:id="@+id/postTime"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:layout_marginStart="8dp"
			android:textColor="@color/zerion_text_secondary_inverse"
			android:textSize="12sp"
			app:layout_constraintBottom_toBottomOf="@+id/postText"
			app:layout_constraintStart_toEndOf="@+id/postText"
			tools:text="13:37" />

	</androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
