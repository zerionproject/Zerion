<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:minHeight="48dp"
	android:layout_marginTop="2dp"
	android:layout_marginBottom="2dp"
	android:orientation="vertical">

	<TextView
		android:id="@+id/senderName"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="14dp"
		android:layout_marginBottom="-6dp"
		android:paddingTop="8dp"
		android:paddingBottom="8dp"
		android:textColor="?attr/zerionColorAccentText"
		tools:text="Alice"
		android:textAppearance="@style/TextAppearance.Zerion.Label" />

	<androidx.constraintlayout.widget.ConstraintLayout
		android:id="@+id/bubble"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="48dp"
		android:background="@drawable/msg_in"
		android:elevation="@dimen/message_bubble_elevation"
		android:paddingHorizontal="12dp"
		android:paddingVertical="8dp">

		<LinearLayout
			android:id="@+id/quoteBlock"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="4dp"
			android:background="@drawable/bg_reply_quote_in"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?android:attr/selectableItemBackground"
			android:minWidth="@dimen/reply_quote_min_width"
			android:minHeight="48dp"
			android:orientation="horizontal"
			android:visibility="gone"
			app:layout_constrainedWidth="true"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			tools:visibility="visible">

			<View
				android:layout_width="3dp"
				android:layout_height="match_parent"
				android:background="@color/selectable_accent_icon" />

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:orientation="vertical"
				android:paddingStart="8dp"
				android:paddingTop="4dp"
				android:paddingEnd="8dp"
				android:paddingBottom="6dp">

				<TextView
					android:id="@+id/quoteAuthor"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxLines="1"
					android:textColor="@color/selectable_accent_text"
					tools:text="Bob"
					android:textAppearance="@style/TextAppearance.Zerion.Label" />

				<TextView
					android:id="@+id/quoteText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxWidth="244dp"
					android:maxLines="1"
					android:textColor="@color/selectable_on_bubble_in_muted"
					tools:text="Quoted post"
					android:textAppearance="@style/TextAppearance.Zerion.Caption" />

			</LinearLayout>

		</LinearLayout>

		<com.professor.zerion.android.view.WrapRow
			android:id="@+id/postTextRow"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:baselineAligned="false"
			android:orientation="horizontal"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/quoteBlock">

			<TextView
				android:id="@+id/postText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:maxWidth="260dp"
				android:textColor="?attr/zerionColorOnBubbleIn"
				tools:text="Hello group"
				android:textColorLink="@color/selectable_accent_text"
				android:textAppearance="@style/TextAppearance.Zerion.Body" />

			<TextView
				android:id="@+id/postTime"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="end|bottom"
				android:layout_marginTop="2dp"
				android:layout_marginStart="8dp"
				android:maxLines="1"
				android:textColor="@color/selectable_on_bubble_in_muted"
				tools:text="13:37"
				android:textAppearance="@style/TextAppearance.Zerion.Meta" />

		</com.professor.zerion.android.view.WrapRow>

	</androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
