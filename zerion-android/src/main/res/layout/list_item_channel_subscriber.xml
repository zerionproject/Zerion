<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/selectableItemBackground"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:paddingStart="16dp"
	android:paddingEnd="16dp"
	android:paddingTop="12dp"
	android:paddingBottom="12dp">

	<com.google.android.material.imageview.ShapeableImageView

		app:shapeAppearanceOverlay="@style/ShapeAppearance.Zerion.Circle"
		android:id="@+id/subscriberAvatar"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_marginEnd="14dp"
		android:src="@drawable/ic_person"
		app:tint="?attr/zerionColorOnSurfaceMuted" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/subscriberName"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textColor="?attr/zerionColorOnSurface"
			tools:text="Alice"
			android:textAppearance="@style/TextAppearance.Zerion.Body" />

		<TextView
			android:id="@+id/subscriberSubtitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="2"
			android:textColor="?attr/zerionColorOnSurfaceMuted"
			android:visibility="gone"
			tools:text="Trusted"
			tools:visibility="visible"
			android:textAppearance="@style/TextAppearance.Zerion.Caption" />

	</LinearLayout>

	<TextView
		android:id="@+id/subscriberBannedBadge"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="@drawable/bg_unread_pill"
		android:paddingStart="6dp"
		android:paddingEnd="6dp"
		android:paddingTop="1dp"
		android:paddingBottom="1dp"
		android:text="@string/channels_settings_blocked"
		android:textColor="?attr/zerionColorOnAccent"
		android:visibility="gone"
		tools:visibility="visible"
		android:textAppearance="@style/TextAppearance.Zerion.Meta.Strong" />

</LinearLayout>
