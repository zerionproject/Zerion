<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/selectableItemBackground"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:paddingStart="16dp"
	android:paddingEnd="16dp"
	android:paddingTop="12dp"
	android:paddingBottom="12dp">

	<de.hdodenhof.circleimageview.CircleImageView
		android:id="@+id/subscriberAvatar"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_marginEnd="14dp"
		android:src="@drawable/ic_person" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/subscriberName"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textColor="@color/zerion_text_primary"
			android:textSize="16sp"
			tools:text="Alice" />

		<TextView
			android:id="@+id/subscriberSubtitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textColor="@color/zerion_text_secondary"
			android:textSize="13sp"
			tools:text="abcd1234…" />

	</LinearLayout>

	<TextView
		android:id="@+id/subscriberBannedBadge"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="@drawable/bg_unread_pill"
		android:paddingStart="6dp"
		android:paddingEnd="6dp"
		android:paddingTop="1dp"
		android:paddingBottom="1dp"
		android:text="@string/channels_subscribers_banned_label"
		android:textColor="@android:color/white"
		android:textSize="10sp"
		android:textStyle="bold"
		android:visibility="gone"
		tools:visibility="visible" />

</LinearLayout>
