<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="16dp"
		android:paddingBottom="32dp">

		<!-- ====== PRIVACY MODE ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/settings_section_mode" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/offline_mode_card"
				style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_settings"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/offline_mode_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/offline_mode_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/offline_mode_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="false" />

			</LinearLayout>

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:layout_marginTop="14dp"
			android:background="@drawable/bg_settings_info_card"
			android:paddingHorizontal="14dp"
			android:paddingVertical="12dp">

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginEnd="12dp"
				android:src="@drawable/ic_info_dark"
				app:tint="@color/zerion_primary_accent"
				android:importantForAccessibility="no" />

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/offline_mode_info"
				android:textSize="13sp"
				android:textColor="@color/zerion_text_secondary"
				android:lineSpacingExtra="1dp" />

		</LinearLayout>

		<!-- ====== TOR NETWORK ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/settings_section_tor_network" />

		<!-- Info card -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:background="@drawable/bg_settings_info_card"
			android:paddingHorizontal="14dp"
			android:paddingVertical="12dp">

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginEnd="12dp"
				android:src="@drawable/ic_info_dark"
				app:tint="@color/zerion_primary_accent"
				android:importantForAccessibility="no" />

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/tor_info_message"
				android:textSize="13sp"
				android:textColor="@color/zerion_text_secondary"
				android:lineSpacingExtra="1dp" />

		</LinearLayout>

		<LinearLayout
			style="@style/Zerion.Settings.Group"
			android:layout_marginTop="14dp">

			<LinearLayout
				android:id="@+id/tor_network_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/transport_tor"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/tor_network_setting" />

					<TextView
						android:id="@+id/tor_network_value"
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/tor_network_setting_automatic" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/custom_bridges_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/transport_tor"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/tor_custom_bridges_title" />

					<TextView
						android:id="@+id/custom_bridges_value"
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/tor_custom_bridges_summary_none" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

		</LinearLayout>

		<!-- ====== OVERLAY NETWORKS (I2P) ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/settings_section_overlay" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/i2p_card"
				style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/transport_i2p"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/i2p_toggle_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/i2p_toggle_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/i2p_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="false" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/i2p_direct_reseed_card"
				style="@style/Zerion.Settings.Row"
				android:visibility="gone">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/transport_i2p"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/i2p_direct_reseed_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/i2p_direct_reseed_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/i2p_direct_reseed_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="false" />

			</LinearLayout>

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:layout_marginTop="14dp"
			android:background="@drawable/bg_settings_info_card"
			android:paddingHorizontal="14dp"
			android:paddingVertical="12dp">

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginEnd="12dp"
				android:src="@drawable/ic_info_dark"
				app:tint="@color/zerion_primary_accent"
				android:importantForAccessibility="no" />

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/i2p_info_message"
				android:textSize="13sp"
				android:textColor="@color/zerion_text_secondary"
				android:lineSpacingExtra="1dp" />

		</LinearLayout>

		<!-- ====== OFFLINE MESH ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/settings_section_mesh" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/mesh_card"
				style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/transport_bt"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/mesh_toggle_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/mesh_toggle_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/mesh_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="false" />

			</LinearLayout>

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:layout_marginTop="14dp"
			android:background="@drawable/bg_settings_info_card"
			android:paddingHorizontal="14dp"
			android:paddingVertical="12dp">

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginEnd="12dp"
				android:src="@drawable/ic_info_dark"
				app:tint="@color/zerion_primary_accent"
				android:importantForAccessibility="no" />

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/mesh_info_message"
				android:textSize="13sp"
				android:textColor="@color/zerion_text_secondary"
				android:lineSpacingExtra="1dp" />

		</LinearLayout>

		<!-- ====== PROXY ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/proxy_section_title" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/orbot_proxy_card"
				style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/transport_tor"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/orbot_proxy_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/orbot_proxy_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/orbot_proxy_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="false" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/orbot_settings_card"
				style="@style/Zerion.Settings.Row.Clickable"
				android:visibility="gone"
				tools:visibility="visible">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/transport_tor"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/orbot_proxy_settings" />

					<TextView
						android:id="@+id/orbot_proxy_value"
						style="@style/Zerion.Settings.Row.Summary"
						android:fontFamily="@font/plex_mono_regular"
						tools:text="127.0.0.1:9050" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

		</LinearLayout>

		<!-- Orbot info -->
		<LinearLayout
			android:id="@+id/orbot_info_card"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:layout_marginTop="14dp"
			android:background="@drawable/bg_settings_info_card"
			android:paddingHorizontal="14dp"
			android:paddingVertical="12dp">

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginEnd="12dp"
				android:src="@drawable/ic_info_dark"
				app:tint="@color/zerion_primary_accent"
				android:importantForAccessibility="no" />

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/orbot_info_message"
				android:textSize="13sp"
				android:textColor="@color/zerion_text_secondary"
				android:lineSpacingExtra="1dp" />

		</LinearLayout>

		<!-- ====== ONION ROTATION ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/onion_rotation_section_title" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/rotate_onion_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_refresh"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_rotate_onion_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/pref_rotate_onion_summary" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/force_complete_rotation_card"
				style="@style/Zerion.Settings.Row.Clickable"
				android:visibility="gone">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_warning"
					app:tint="@color/zerion_destructive"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:textColor="@color/zerion_destructive"
						android:text="@string/pref_force_complete_rotation_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/pref_force_complete_rotation_summary" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

		</LinearLayout>

	</LinearLayout>

</ScrollView>
