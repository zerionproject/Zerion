<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingStart="12dp"
	android:paddingEnd="12dp"
	android:paddingTop="6dp"
	android:paddingBottom="6dp">

	<LinearLayout
		android:id="@+id/layout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/bg_channel_card"
		android:orientation="vertical"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:paddingTop="12dp"
		android:paddingBottom="6dp">

		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/channelPostHeader"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:importantForAccessibility="noHideDescendants">

			<TextView
				android:id="@+id/channelPostAvatar"
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:autoSizeMaxTextSize="13sp"
				android:autoSizeMinTextSize="8sp"
				android:autoSizeTextType="uniform"
				android:background="@drawable/bg_chat_avatar"
				android:gravity="center"
				android:maxLines="1"
				android:textColor="?attr/zerionColorOnAccent"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent"
				tools:text="N"
				android:textAppearance="@style/TextAppearance.Zerion.Label" />

			<com.professor.zerion.android.view.WrapRow
				android:id="@+id/channelPostHeaderLine"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="10dp"
				android:baselineAligned="false"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				app:layout_constrainedWidth="true"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintHorizontal_bias="0"
				app:layout_constraintStart_toEndOf="@+id/channelPostAvatar"
				app:layout_constraintTop_toTopOf="parent">

				<com.professor.zerion.android.view.WrapRow
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginEnd="8dp"
					android:layout_weight="1"
					android:baselineAligned="false"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:id="@+id/channelPostAuthor"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:ellipsize="end"
						android:maxLines="1"
						android:textColor="?attr/zerionColorOnSurface"
						tools:text="Neighbourhood updates"
						android:textAppearance="@style/TextAppearance.Zerion.Label" />

					<TextView
						android:id="@+id/channelPostSignerBadge"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="8dp"
						android:background="@drawable/bg_unread_pill"
						android:contentDescription="@string/channels_post_signer_editor_description"
						android:maxLines="1"
						android:paddingStart="6dp"
						android:paddingEnd="6dp"
						android:paddingTop="1dp"
						android:paddingBottom="1dp"
						android:textColor="?attr/zerionColorOnAccent"
						android:visibility="gone"
						tools:text="EDITOR"
						tools:visibility="visible"
						android:textAppearance="@style/TextAppearance.Zerion.Meta.Strong" />

				</com.professor.zerion.android.view.WrapRow>

				<TextView
					android:id="@+id/channelPostTimestampView"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:textColor="@color/selectable_on_surface_muted"
					tools:text="Today 09:00 · edited"
					android:textAppearance="@style/TextAppearance.Zerion.Meta" />

			</com.professor.zerion.android.view.WrapRow>

		</androidx.constraintlayout.widget.ConstraintLayout>

		<com.vanniktech.emoji.EmojiTextView
			android:id="@+id/channelPostBodyView"
			style="@style/TextMessage"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:textColor="?attr/zerionColorOnSurface"
			android:textColorLink="@color/selectable_accent_text"
			tools:text="Route for Saturday: we start at the community hall and finish at the station." />

		<LinearLayout
			android:id="@+id/channelPostAttachments"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:orientation="vertical"
			android:visibility="gone"
			tools:visibility="visible" />

		<TextView
			android:id="@+id/channelPostReactionsView"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:background="@drawable/bg_channel_attachment"
			android:minHeight="32dp"
			android:gravity="center_vertical"
			android:paddingStart="10dp"
			android:paddingEnd="10dp"
			android:paddingTop="4dp"
			android:paddingBottom="4dp"
			android:textColor="?attr/zerionColorOnSurface"
			android:visibility="gone"
			tools:text="👍 3   ❤️ 1"
			tools:visibility="visible"
			android:textAppearance="@style/TextAppearance.Zerion.Caption" />

		<View
			android:id="@+id/channelPostFooterDivider"
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginTop="10dp"
			android:background="?attr/zerionColorDivider" />

		<com.professor.zerion.android.view.WrapRow
			android:id="@+id/channelPostFooter"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/channelPostCommentBadge"
				style="@style/Widget.MaterialComponents.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="-8dp"
				android:minWidth="48dp"
				android:minHeight="48dp"
				android:text="@string/channels_action_comments"
				android:textColor="@color/selectable_accent_text"
				android:visibility="gone"
				app:icon="@drawable/ic_chat"
				app:iconPadding="6dp"
				app:iconSize="18dp"
				app:iconTint="@color/selectable_accent_icon"
				tools:text="Comments 4"
				tools:visibility="visible"
				android:textAppearance="@style/TextAppearance.Zerion.Label" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/channelPostReactButton"
				style="@style/Widget.MaterialComponents.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:minWidth="48dp"
				android:minHeight="48dp"
				android:text="@string/action_react"
				android:textColor="@color/selectable_accent_text"
				android:visibility="gone"
				app:icon="@drawable/ic_emoji_toggle"
				app:iconPadding="6dp"
				app:iconSize="18dp"
				app:iconTint="@color/selectable_accent_icon"
				tools:visibility="visible"
				android:textAppearance="@style/TextAppearance.Zerion.Label" />

			<TextView
				android:id="@+id/channelPostTtlLabel"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:ellipsize="end"
				android:gravity="end|center_vertical"
				android:maxLines="1"
				android:minHeight="48dp"
				android:textColor="@color/selectable_on_surface_muted"
				android:visibility="gone"
				tools:text="Disappears in 6 days"
				tools:visibility="visible"
				android:textAppearance="@style/TextAppearance.Zerion.Meta" />

		</com.professor.zerion.android.view.WrapRow>

	</LinearLayout>

	<include
		layout="@layout/view_message_not_sent_actions"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="end"
		android:layout_marginTop="2dp" />

</LinearLayout>
