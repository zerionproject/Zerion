<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_zerion_gradient"
    tools:context=".android.conversation.ConversationActivity">

    <!-- TOP APP BAR - Modern 2025 Style -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_transparent"
        android:elevation="6dp"
        app:elevation="6dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Zerion.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/toolbarTitleBlock"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="8dp">

                <include layout="@layout/contact_avatar_status" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <com.vanniktech.emoji.EmojiTextView
                        android:id="@+id/contactName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:fontFamily="@font/bricolage_grotesque"
                        android:textFontWeight="500"
                        android:letterSpacing="0.01"
                        tools:text="Contact Name" />

                    <TextView
                        android:id="@+id/contactSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#CCFFFFFF"
                        android:textSize="11sp"
                        android:letterSpacing="0.02"
                        tools:text="End-to-end encrypted" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- MAIN CONTENT WRAPPER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- MESSAGE LIST AREA WITH EDGE-TO-EDGE BEHAVIOR -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <com.professor.zerion.android.view.ZerionRecyclerView
                android:id="@+id/conversationView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:scrollToEnd="false" />

            <!-- SCROLL TO BOTTOM FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/scrollToBottomButton"
                style="@style/Zerion.FAB.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="@string/scroll_to_bottom"
                android:visibility="gone"
                app:srcCompat="@drawable/chevron_down_white" />

        </FrameLayout>

        <!-- IMAGE PREVIEW AREA -->
        <com.professor.zerion.android.view.ImagePreview
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- TYPING INDICATOR -->
        <TextView
            android:id="@+id/typingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/zerion_accent"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <!-- VERIFY-TO-SEND-MEDIA BANNER -->
        <TextView
            android:id="@+id/verifyMediaBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_input_bar"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/verify_to_send_media_banner"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- INPUT CONTAINER WITH NORMAL AND RECORDING MODES -->
        <FrameLayout
            android:id="@+id/input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp">

            <!-- MODERN FLOATING INPUT BAR -->
            <com.professor.zerion.android.view.TextInputView
                android:id="@+id/text_input_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_bar"
                android:elevation="8dp"
                android:clipToPadding="false" />

            <!-- VOICE RECORDING MODE (replaces text input when recording) -->
            <include
                android:id="@+id/voiceRecordingOverlay"
                layout="@layout/voice_recording_overlay" />

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
