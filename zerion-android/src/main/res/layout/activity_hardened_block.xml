<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/window_background"
	android:fitsSystemWindows="true"
	android:padding="24dp">

	<TextView
		android:id="@+id/hardenedBlockTitle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="48dp"
		android:textColor="@color/zerion_text_primary"
		android:textSize="22sp"
		android:textStyle="bold"
		app:layout_constraintTop_toTopOf="parent" />

	<TextView
		android:id="@+id/hardenedBlockDetail"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="24dp"
		android:lineSpacingExtra="4dp"
		android:textColor="@color/zerion_text_primary"
		android:textSize="15sp"
		app:layout_constraintTop_toBottomOf="@+id/hardenedBlockTitle" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/hardenedBlockDisableButton"
		style="@style/Widget.MaterialComponents.Button.OutlinedButton"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="12dp"
		android:text="@string/hardened_block_disable_action"
		app:layout_constraintBottom_toTopOf="@+id/hardenedBlockQuitButton" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/hardenedBlockQuitButton"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="32dp"
		android:text="@string/hardened_block_quit_action"
		app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
