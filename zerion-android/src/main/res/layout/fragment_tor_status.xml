<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="20dp">

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			app:cardBackgroundColor="#1E1E1E"
			app:cardCornerRadius="16dp"
			app:cardElevation="4dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:padding="16dp"
				android:gravity="center_vertical">

				<ImageView
					android:id="@+id/torStatusIcon"
					android:layout_width="32dp"
					android:layout_height="32dp"
					android:src="@drawable/transport_tor"
					app:tint="#26B7F0"/>

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginStart="12dp"
					android:orientation="vertical">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/transport_tor"
						android:textColor="#FFFFFF"
						android:textSize="18sp"
						android:textStyle="bold"/>

					<TextView
						android:id="@+id/torOnionAddress"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/generating"
						android:textColor="#888888"
						android:textSize="11sp"
						android:layout_marginTop="2dp"
						tools:text="Hidden service active"/>

				</LinearLayout>

				<TextView
					android:id="@+id/torStatusText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/connected"
					android:textColor="#4CAF50"
					android:textSize="14sp"
					android:textStyle="bold"
					tools:text="Connected"/>

			</LinearLayout>

		</com.google.android.material.card.MaterialCardView>

		<com.professor.zerion.android.view.NetworkGraphView
			android:id="@+id/networkGraph"
			android:layout_width="match_parent"
			android:layout_height="160dp"
			android:layout_marginBottom="16dp"/>

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:cardBackgroundColor="#1E1E1E"
			app:cardCornerRadius="16dp"
			app:cardElevation="4dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:padding="16dp">

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical"
					android:gravity="center">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/network_total_download"
						android:textColor="#AAAAAA"
						android:textSize="11sp"/>

					<TextView
						android:id="@+id/totalDownload"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="0 B"
						android:textColor="#26B7F0"
						android:textSize="18sp"
						android:textStyle="bold"
						android:layout_marginTop="4dp"
						tools:text="1.24 MB"/>

				</LinearLayout>

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical"
					android:gravity="center">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/network_total_upload"
						android:textColor="#AAAAAA"
						android:textSize="11sp"/>

					<TextView
						android:id="@+id/totalUpload"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="0 B"
						android:textColor="#4CAF50"
						android:textSize="18sp"
						android:textStyle="bold"
						android:layout_marginTop="4dp"
						tools:text="456 KB"/>

				</LinearLayout>

				<ImageView
					android:id="@+id/clearStatsButton"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:src="@drawable/ic_refresh"
					android:background="?attr/selectableItemBackgroundBorderless"
					android:contentDescription="@string/clear"
					app:tint="#666666"/>

			</LinearLayout>

		</com.google.android.material.card.MaterialCardView>

	</LinearLayout>

</ScrollView>
