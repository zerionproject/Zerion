<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/zerion_dark_bg"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="20dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@color/zerion_surface_elevated"
			android:orientation="horizontal"
			android:padding="16dp"
			android:gravity="center_vertical"
			android:layout_marginBottom="12dp">

			<ImageView
				android:id="@+id/torStatusIcon"
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:src="@drawable/transport_tor"
				android:importantForAccessibility="no"
				app:tint="@color/zerion_primary_accent" />

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:layout_marginStart="14dp"
				android:orientation="vertical">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/transport_tor"
					android:textColor="@color/zerion_text_primary"
					android:textSize="17sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/torOnionAddress"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="@string/generating"
					android:textColor="@color/zerion_text_secondary"
					android:textSize="12sp"
					tools:text="@string/tor_hidden_services_active" />

			</LinearLayout>

			<TextView
				android:id="@+id/torStatusText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/connected"
				android:textColor="@color/zerion_success"
				android:textSize="14sp"
				android:textStyle="bold"
				tools:text="@string/connected" />

		</LinearLayout>

		<LinearLayout
			android:id="@+id/onionCard"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@color/zerion_surface_elevated"
			android:orientation="vertical"
			android:padding="16dp"
			android:visibility="gone"
			tools:visibility="visible">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/tor_your_onion_label"
				android:textColor="@color/zerion_text_secondary"
				android:textSize="12sp"
				android:textAllCaps="true"
				android:letterSpacing="0.05" />

			<TextView
				android:id="@+id/onionAddressValue"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:fontFamily="monospace"
				android:textColor="@color/zerion_text_primary"
				android:textIsSelectable="true"
				android:textSize="13sp"
				tools:text="exampleabcd1234efgh5678ijkl90mnop123qrs456tuv789wxyz0123456.onion" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:gravity="end"
				android:orientation="horizontal">

				<com.google.android.material.button.MaterialButton
					android:id="@+id/onionCopyButton"
					style="@style/Widget.Material3.Button.TonalButton"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/tor_onion_copy"
					app:icon="@drawable/ic_content_copy"
					app:iconGravity="textStart" />

			</LinearLayout>

		</LinearLayout>

		<LinearLayout
			android:id="@+id/rotationCard"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@color/zerion_surface_elevated"
			android:orientation="vertical"
			android:padding="16dp"
			android:layout_marginTop="12dp"
			android:visibility="gone"
			tools:visibility="visible">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical">

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_refresh"
					app:tint="@color/zerion_warning"
					android:importantForAccessibility="no" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:text="@string/tor_rotation_in_progress"
					android:textColor="@color/zerion_warning"
					android:textSize="12sp"
					android:textAllCaps="true"
					android:letterSpacing="0.05" />

			</LinearLayout>

			<TextView
				android:id="@+id/rotationPendingValue"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:fontFamily="monospace"
				android:textColor="@color/zerion_text_primary"
				android:textIsSelectable="true"
				android:textSize="13sp"
				tools:text="newaddrabcd1234efgh5678ijkl90mnop123qrs456tuv789wxyz9876543.onion" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:text="@string/tor_rotation_explainer"
				android:textColor="@color/zerion_text_secondary"
				android:textSize="12sp" />

		</LinearLayout>

	</LinearLayout>

</ScrollView>
