<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/selectableItemBackground"
	android:paddingVertical="10dp">

	<com.professor.zerion.android.view.TextAvatarView
		android:id="@+id/avatarView"
		android:layout_width="52dp"
		android:layout_height="52dp"
		android:layout_marginStart="16dp"
		android:layout_marginTop="2dp"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

	<com.vanniktech.emoji.EmojiTextView
		android:id="@+id/nameView"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="14dp"
		android:layout_marginEnd="12dp"
		android:ellipsize="end"
		android:maxLines="1"
		android:textColor="@color/zerion_text_primary"
		android:textSize="16sp"
		android:textStyle="bold"
		android:letterSpacing="0.005"
		app:layout_constraintEnd_toStartOf="@+id/dateView"
		app:layout_constraintStart_toEndOf="@+id/avatarView"
		app:layout_constraintTop_toTopOf="@+id/avatarView"
		tools:text="Private Group Name" />

	<TextView
		android:id="@+id/dateView"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="16dp"
		android:textColor="@color/zerion_text_secondary"
		android:textSize="12sp"
		app:layout_constraintBaseline_toBaselineOf="@+id/nameView"
		app:layout_constraintEnd_toEndOf="parent"
		tools:text="3 weeks" />

	<com.vanniktech.emoji.EmojiTextView
		android:id="@+id/creatorView"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="14dp"
		android:layout_marginTop="2dp"
		android:layout_marginEnd="16dp"
		android:ellipsize="end"
		android:maxLines="1"
		android:textColor="@color/zerion_text_secondary"
		android:textSize="13sp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toEndOf="@+id/avatarView"
		app:layout_constraintTop_toBottomOf="@+id/nameView"
		tools:text="Created by Santa Claus" />

	<TextView
		android:id="@+id/statusView"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="14dp"
		android:layout_marginTop="2dp"
		android:layout_marginEnd="12dp"
		android:ellipsize="end"
		android:maxLines="1"
		android:textColor="@color/zerion_text_secondary"
		android:textSize="13sp"
		android:alpha="0.85"
		app:layout_constraintEnd_toStartOf="@+id/messageCountView"
		app:layout_constraintStart_toEndOf="@+id/avatarView"
		app:layout_constraintTop_toBottomOf="@+id/creatorView"
		tools:text="This group is empty" />

	<TextView
		android:id="@+id/messageCountView"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="16dp"
		android:textColor="@color/zerion_text_secondary"
		android:textSize="12sp"
		app:layout_constraintBaseline_toBaselineOf="@+id/statusView"
		app:layout_constraintEnd_toEndOf="parent"
		tools:text="1337 messages" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/removeButton"
		style="@style/Zerion.Button.Negative"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="8dp"
		android:layout_marginTop="4dp"
		android:text="@string/groups_remove"
		android:visibility="gone"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/statusView"
		tools:visibility="visible" />

	<View
		android:id="@+id/divider"
		android:layout_width="0dp"
		android:layout_height="1dp"
		android:layout_marginStart="14dp"
		android:layout_marginTop="10dp"
		android:background="@color/zerion_divider"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toEndOf="@+id/avatarView"
		app:layout_constraintTop_toBottomOf="@+id/statusView" />

</androidx.constraintlayout.widget.ConstraintLayout>
