<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/zerion_dark_bg"
	android:fitsSystemWindows="true">

	<androidx.appcompat.widget.Toolbar
		android:id="@+id/delegationsToolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:background="@color/zerion_dark_bg"
		app:layout_constraintTop_toTopOf="parent"
		app:title="@string/channels_delegations_title"
		app:titleTextColor="@color/zerion_text_primary" />

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/delegationsToolbar">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingBottom="32dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_marginTop="8dp"
				android:layout_marginEnd="12dp"
				android:background="@color/zerion_card_bg"
				android:orientation="vertical">

				<LinearLayout
					android:id="@+id/delegationsAddRow"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="?attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:paddingTop="14dp"
					android:paddingBottom="14dp">

					<ImageView
						android:layout_width="28dp"
						android:layout_height="28dp"
						android:layout_marginEnd="14dp"
						android:contentDescription="@string/channels_delegations_add"
						android:src="@drawable/ic_admin_add"
						app:tint="@color/zerion_primary_accent" />

					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/channels_delegations_add"
						android:textColor="@color/zerion_primary_accent"
						android:textSize="16sp" />

				</LinearLayout>

				<View
					android:layout_width="match_parent"
					android:layout_height="0.5dp"
					android:layout_marginStart="56dp"
					android:background="@color/zerion_divider" />

				<LinearLayout
					android:id="@+id/delegationsOwnerRow"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:paddingTop="12dp"
					android:paddingBottom="12dp">

					<com.google.android.material.imageview.ShapeableImageView

						app:shapeAppearanceOverlay="@style/ShapeAppearance.Zerion.Circle"
						android:id="@+id/delegationsOwnerAvatar"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:layout_marginEnd="14dp"
						android:src="@drawable/ic_person" />

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical">

						<TextView
							android:id="@+id/delegationsOwnerName"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:textColor="@color/zerion_text_primary"
							android:textSize="16sp"
							android:textStyle="bold"
							tools:text="You" />

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="@string/channels_delegations_role_owner"
							android:textColor="@color/zerion_text_secondary"
							android:textSize="13sp" />

					</LinearLayout>

				</LinearLayout>

				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/delegationsRecycler"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:overScrollMode="never"
					android:nestedScrollingEnabled="false" />

			</LinearLayout>

			<TextView
				android:id="@+id/delegationsHelp"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="16dp"
				android:layout_marginTop="10dp"
				android:layout_marginEnd="16dp"
				android:text="@string/channels_delegations_help"
				android:textColor="@color/zerion_text_secondary"
				android:textSize="13sp" />

			<TextView
				android:id="@+id/delegationsEmptyView"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:gravity="center"
				android:paddingStart="32dp"
				android:paddingEnd="32dp"
				android:text="@string/channels_delegations_empty"
				android:textColor="@color/zerion_text_secondary"
				android:textSize="14sp"
				android:visibility="gone"
				tools:visibility="visible" />

		</LinearLayout>

	</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
