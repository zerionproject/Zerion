<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/selectableItemBackground"
	android:minHeight="52dp"
	android:paddingStart="16dp"
	android:paddingEnd="16dp"
	android:paddingTop="12dp"
	android:paddingBottom="12dp">

	<TextView
		android:id="@+id/delegationKeyView"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:ellipsize="end"
		android:maxLines="1"
		android:textColor="?attr/zerionColorOnSurface"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		tools:text="Robin"
		android:textAppearance="@style/TextAppearance.Zerion.Body" />

	<TextView
		android:id="@+id/delegationValidityView"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginTop="2dp"
		android:textColor="?attr/zerionColorOnSurfaceMuted"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/delegationKeyView"
		tools:text="No expiry"
		android:textAppearance="@style/TextAppearance.Zerion.Meta" />

</androidx.constraintlayout.widget.ConstraintLayout>
