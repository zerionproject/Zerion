<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingStart="16dp"
	android:paddingEnd="8dp"
	android:paddingTop="12dp"
	android:paddingBottom="12dp">

	<TextView
		android:id="@+id/delegationKeyView"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:ellipsize="middle"
		android:maxLines="1"
		android:fontFamily="monospace"
		android:textColor="@color/zerion_text_primary"
		android:textSize="13sp"
		app:layout_constraintEnd_toStartOf="@+id/delegationRevokeButton"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		tools:text="abc123def456...xyz789" />

	<TextView
		android:id="@+id/delegationValidityView"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginTop="2dp"
		android:textColor="@color/zerion_text_secondary"
		android:textSize="12sp"
		app:layout_constraintEnd_toStartOf="@+id/delegationRevokeButton"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/delegationKeyView"
		tools:text="No expiry · seq 1" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/delegationRevokeButton"
		style="@style/Widget.MaterialComponents.Button.TextButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:minWidth="0dp"
		android:text="@string/channels_delegations_revoke"
		android:textColor="@color/zerion_destructive"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
