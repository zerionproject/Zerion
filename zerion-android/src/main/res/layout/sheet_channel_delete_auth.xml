<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/channelDeleteAuthSheet"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/bg_sheet"
	android:orientation="vertical"
	android:paddingStart="24dp"
	android:paddingTop="8dp"
	android:paddingEnd="24dp"
	android:paddingBottom="24dp">

	<View
		android:layout_width="36dp"
		android:layout_height="4dp"
		android:layout_gravity="center_horizontal"
		android:layout_marginBottom="14dp"
		android:background="@drawable/bg_sheet_handle"
		android:importantForAccessibility="no" />

	<ImageView
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:background="@drawable/bg_sheet_icon_circle"
		android:contentDescription="@null"
		android:importantForAccessibility="no"
		android:padding="12dp"
		android:src="@drawable/ic_lock"
		app:tint="?attr/zerionColorDangerText" />

	<TextView
		android:id="@+id/channelDeleteAuthTitle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="14dp"
		android:accessibilityHeading="true"
		android:text="@string/channels_delete_auth_title"
		android:fontFamily="@font/bricolage_grotesque"
		android:textAppearance="@style/TextAppearance.Zerion.Headline"
		android:textColor="?attr/zerionColorOnSurface" />

	<TextView
		android:id="@+id/channelDeleteAuthMessage"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:textAppearance="@style/TextAppearance.Zerion.BodySmall"
		android:textColor="?attr/zerionColorOnSurface"
		tools:text="Enter your password to delete News for everyone. This cannot be undone." />

	<com.google.android.material.textfield.TextInputLayout
		android:id="@+id/channelDeleteAuthPasswordLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:hint="@string/hardened_block_password_hint"
		app:endIconMode="password_toggle"
		app:errorAccessibilityLiveRegion="1"
		app:errorEnabled="true">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/channelDeleteAuthPassword"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:imeOptions="actionDone|flagNoPersonalizedLearning"
			android:importantForAutofill="no"
			android:inputType="textPassword"
			android:maxLines="1"
			android:privateImeOptions="nm"
			android:saveEnabled="false" />

	</com.google.android.material.textfield.TextInputLayout>

	<ProgressBar
		android:id="@+id/channelDeleteAuthProgress"
		style="?android:attr/progressBarStyleSmall"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center_horizontal"
		android:layout_marginTop="8dp"
		android:indeterminateTint="?attr/zerionColorAccentIcon"
		android:visibility="gone" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:gravity="end"
		android:orientation="horizontal">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/channelDeleteAuthCancel"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:text="@android:string/cancel"
			android:textColor="?attr/zerionColorOnSurface" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/channelDeleteAuthConfirm"
			style="@style/Widget.Material3.Button.OutlinedButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:minHeight="48dp"
			android:text="@string/channels_delete_auth_action"
			android:textColor="?attr/zerionColorDangerText"
			app:strokeColor="?attr/zerionColorDangerText" />

	</LinearLayout>

</LinearLayout>
