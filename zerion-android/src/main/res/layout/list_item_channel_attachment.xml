<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="6dp"
	android:minHeight="48dp"
	android:orientation="vertical"
	android:background="@drawable/bg_channel_attachment"
	android:foreground="?attr/selectableItemBackground"
	android:clickable="true"
	android:focusable="true"
	android:paddingStart="12dp"
	android:paddingEnd="12dp"
	android:paddingTop="8dp"
	android:paddingBottom="8dp">

	<LinearLayout
		android:id="@+id/channelAttachmentRow"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<ImageView
			android:id="@+id/channelAttachmentIcon"
			android:layout_width="32dp"
			android:layout_height="32dp"
			android:layout_marginEnd="12dp"
			android:importantForAccessibility="no"
			android:padding="4dp"
			android:src="@drawable/ic_file"
			app:tint="@color/selectable_on_surface_muted" />

		<ProgressBar
			android:id="@+id/channelAttachmentProgress"
			style="?android:attr/progressBarStyleSmall"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:layout_marginEnd="8dp"
			android:indeterminate="true"
			android:visibility="gone"
			tools:visibility="gone" />

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:id="@+id/channelAttachmentMime"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="1"
				android:textColor="?attr/zerionColorOnSurface"
				tools:text="PDF document"
				android:textAppearance="@style/TextAppearance.Zerion.BodySmall" />

			<TextView
				android:id="@+id/channelAttachmentSize"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textColor="@color/selectable_on_surface_muted"
				tools:text="1.2 MB"
				android:textAppearance="@style/TextAppearance.Zerion.Meta" />

		</LinearLayout>

	</LinearLayout>

	<ImageView
		android:id="@+id/channelAttachmentThumb"
		app:tint="@color/selected_media"
		app:tintMode="src_atop"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:adjustViewBounds="true"
		android:importantForAccessibility="no"
		android:maxHeight="320dp"
		android:scaleType="fitStart"
		android:visibility="gone"
		tools:visibility="gone" />

</LinearLayout>
