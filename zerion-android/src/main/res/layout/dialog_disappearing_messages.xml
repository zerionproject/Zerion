<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_zerion_gradient">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/menu_item_disappearing_messages"
        android:textColor="?attr/zerionColorOnSurface"
        android:paddingBottom="16dp"
        android:fontFamily="@font/bricolage_grotesque"
        android:textAppearance="@style/TextAppearance.Zerion.Headline" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:scrollbars="vertical">

        <RadioGroup
            android:id="@+id/disappearing_messages_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/timer_5_minutes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/dialog_disappearing_5_minutes"
                android:textColor="?attr/zerionColorOnSurface"
                android:buttonTint="?attr/zerionColorAccentIcon"
                android:textAppearance="@style/TextAppearance.Zerion.Body" />

            <RadioButton
                android:id="@+id/timer_30_minutes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/dialog_disappearing_30_minutes"
                android:textColor="?attr/zerionColorOnSurface"
                android:buttonTint="?attr/zerionColorAccentIcon"
                android:textAppearance="@style/TextAppearance.Zerion.Body" />

            <RadioButton
                android:id="@+id/timer_1_hour"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/dialog_disappearing_1_hour"
                android:textColor="?attr/zerionColorOnSurface"
                android:buttonTint="?attr/zerionColorAccentIcon"
                android:textAppearance="@style/TextAppearance.Zerion.Body" />

            <RadioButton
                android:id="@+id/timer_8_hours"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/dialog_disappearing_8_hours"
                android:textColor="?attr/zerionColorOnSurface"
                android:buttonTint="?attr/zerionColorAccentIcon"
                android:textAppearance="@style/TextAppearance.Zerion.Body" />

            <RadioButton
                android:id="@+id/timer_12_hours"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/dialog_disappearing_12_hours"
                android:textColor="?attr/zerionColorOnSurface"
                android:buttonTint="?attr/zerionColorAccentIcon"
                android:textAppearance="@style/TextAppearance.Zerion.Body" />

            <RadioButton
                android:id="@+id/timer_24_hours"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/dialog_disappearing_24_hours"
                android:textColor="?attr/zerionColorOnSurface"
                android:buttonTint="?attr/zerionColorAccentIcon"
                android:textAppearance="@style/TextAppearance.Zerion.Body" />

            <RadioButton
                android:id="@+id/timer_1_week"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/dialog_disappearing_1_week"
                android:textColor="?attr/zerionColorOnSurface"
                android:buttonTint="?attr/zerionColorAccentIcon"
                android:textAppearance="@style/TextAppearance.Zerion.Body" />

            <RadioButton
                android:id="@+id/timer_4_weeks"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/dialog_disappearing_4_weeks"
                android:textColor="?attr/zerionColorOnSurface"
                android:buttonTint="?attr/zerionColorAccentIcon"
                android:textAppearance="@style/TextAppearance.Zerion.Body" />

            <RadioButton
                android:id="@+id/timer_custom"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/dialog_disappearing_custom"
                android:textColor="?attr/zerionColorOnSurface"
                android:buttonTint="?attr/zerionColorAccentIcon"
                android:textAppearance="@style/TextAppearance.Zerion.Body" />

            <RadioButton
                android:id="@+id/timer_off"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/dialog_disappearing_off"
                android:textColor="?attr/zerionColorOnSurface"
                android:buttonTint="?attr/zerionColorAccentIcon"
                android:checked="true"
                android:textAppearance="@style/TextAppearance.Zerion.Body" />

        </RadioGroup>

    </ScrollView>

</LinearLayout>
