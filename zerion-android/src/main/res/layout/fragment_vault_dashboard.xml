<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient">

	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingHorizontal="16dp"
			android:paddingTop="16dp"
			android:paddingBottom="32dp">

			<!-- Stats summary -->
			<LinearLayout
				android:id="@+id/stats_card"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:background="@drawable/bg_settings_group"
				android:paddingVertical="18dp">

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical"
					android:gravity="center">

					<TextView
						android:id="@+id/notes_count"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="26sp"
						android:textStyle="bold"
						android:textColor="@color/zerion_primary_accent"
						tools:text="12" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="@string/vault_stat_notes"
						android:textSize="11sp"
						android:letterSpacing="0.05"
						android:textColor="@color/zerion_text_secondary" />

				</LinearLayout>

				<View
					android:layout_width="1dp"
					android:layout_height="36dp"
					android:layout_gravity="center_vertical"
					android:background="@color/zerion_divider" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical"
					android:gravity="center">

					<TextView
						android:id="@+id/images_count"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="26sp"
						android:textStyle="bold"
						android:textColor="@color/zerion_primary_accent"
						tools:text="3" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="@string/vault_stat_images"
						android:textSize="11sp"
						android:letterSpacing="0.05"
						android:textColor="@color/zerion_text_secondary" />

				</LinearLayout>

				<View
					android:layout_width="1dp"
					android:layout_height="36dp"
					android:layout_gravity="center_vertical"
					android:background="@color/zerion_divider" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical"
					android:gravity="center">

					<TextView
						android:id="@+id/docs_count"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="26sp"
						android:textStyle="bold"
						android:textColor="@color/zerion_primary_accent"
						tools:text="0" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="@string/vault_stat_documents"
						android:textSize="11sp"
						android:letterSpacing="0.05"
						android:textColor="@color/zerion_text_secondary" />

				</LinearLayout>

			</LinearLayout>

			<!-- Categories grid -->
			<GridLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="14dp"
				android:columnCount="2"
				android:rowCount="2"
				android:alignmentMode="alignMargins"
				android:columnOrderPreserved="false"
				android:rowOrderPreserved="false">

				<!-- Notes -->
				<LinearLayout
					android:id="@+id/notes_card"
					android:layout_width="0dp"
					android:layout_height="148dp"
					android:layout_columnWeight="1"
					android:layout_margin="6dp"
					android:orientation="vertical"
					android:padding="18dp"
					android:background="@drawable/bg_settings_group"
					android:foreground="?attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true">

					<FrameLayout
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:background="@drawable/bg_vault_card_purple">

						<ImageView
							android:layout_width="22dp"
							android:layout_height="22dp"
							android:layout_gravity="center"
							android:src="@drawable/ic_notes"
							app:tint="#A78BFA"
							android:importantForAccessibility="no" />

					</FrameLayout>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:text="@string/vault_card_notes_title"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="@color/zerion_text_primary" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="@string/vault_card_notes_subtitle"
						android:textSize="12sp"
						android:textColor="@color/zerion_text_secondary" />

				</LinearLayout>

				<!-- Gallery -->
				<LinearLayout
					android:id="@+id/gallery_card"
					android:layout_width="0dp"
					android:layout_height="148dp"
					android:layout_columnWeight="1"
					android:layout_margin="6dp"
					android:orientation="vertical"
					android:padding="18dp"
					android:background="@drawable/bg_settings_group"
					android:foreground="?attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true">

					<FrameLayout
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:background="@drawable/bg_vault_card_blue">

						<ImageView
							android:layout_width="22dp"
							android:layout_height="22dp"
							android:layout_gravity="center"
							android:src="@drawable/ic_photo"
							app:tint="@color/zerion_primary_accent"
							android:importantForAccessibility="no" />

					</FrameLayout>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:text="@string/vault_card_gallery_title"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="@color/zerion_text_primary" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="@string/vault_card_gallery_subtitle"
						android:textSize="12sp"
						android:textColor="@color/zerion_text_secondary" />

				</LinearLayout>

				<!-- Documents -->
				<LinearLayout
					android:id="@+id/documents_card"
					android:layout_width="0dp"
					android:layout_height="148dp"
					android:layout_columnWeight="1"
					android:layout_margin="6dp"
					android:orientation="vertical"
					android:padding="18dp"
					android:background="@drawable/bg_settings_group"
					android:foreground="?attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true">

					<FrameLayout
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:background="@drawable/bg_vault_card_orange">

						<ImageView
							android:layout_width="22dp"
							android:layout_height="22dp"
							android:layout_gravity="center"
							android:src="@drawable/ic_document"
							app:tint="@color/zerion_warning"
							android:importantForAccessibility="no" />

					</FrameLayout>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:text="@string/vault_card_documents_title"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="@color/zerion_text_primary" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="@string/vault_card_documents_subtitle"
						android:textSize="12sp"
						android:textColor="@color/zerion_text_secondary" />

				</LinearLayout>

				<!-- Passwords -->
				<LinearLayout
					android:id="@+id/passwords_card"
					android:layout_width="0dp"
					android:layout_height="148dp"
					android:layout_columnWeight="1"
					android:layout_margin="6dp"
					android:orientation="vertical"
					android:padding="18dp"
					android:background="@drawable/bg_settings_group"
					android:foreground="?attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true">

					<FrameLayout
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:background="@drawable/bg_vault_card_green">

						<ImageView
							android:layout_width="22dp"
							android:layout_height="22dp"
							android:layout_gravity="center"
							android:src="@drawable/ic_key"
							app:tint="@color/zerion_success"
							android:importantForAccessibility="no" />

					</FrameLayout>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:text="@string/vault_card_passwords_title"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="@color/zerion_text_primary" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="@string/vault_card_passwords_subtitle"
						android:textSize="12sp"
						android:textColor="@color/zerion_text_secondary" />

				</LinearLayout>

			</GridLayout>

		</LinearLayout>

	</androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
