<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/image"
        tools:src="@drawable/ic_image" />

    <!-- Document overlay for non-images -->
    <LinearLayout
        android:id="@+id/document_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_contact_card"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/document_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_document"
            android:contentDescription="@string/document"
            android:tint="@color/zerion_primary_accent" />

        <TextView
            android:id="@+id/document_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/zerion_text_primary"
            android:textSize="12sp"
            android:padding="8dp"
            tools:text="document.pdf" />

    </LinearLayout>

</FrameLayout>
