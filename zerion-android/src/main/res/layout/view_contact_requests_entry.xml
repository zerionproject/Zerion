<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/contactRequestsEntry"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/selectableItemBackground"
	android:clickable="true"
	android:focusable="true"
	android:gravity="center_vertical"
	android:minHeight="48dp"
	android:orientation="horizontal"
	android:paddingHorizontal="16dp">

	<TextView
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:text="@string/requests_title"
		android:textColor="@color/zerion_text_primary"
		android:textSize="15sp" />

	<TextView
		android:id="@+id/contactRequestsBadge"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:background="@drawable/bg_recommended_badge"
		android:paddingHorizontal="10dp"
		android:paddingVertical="3dp"
		android:textColor="@color/zerion_on_accent"
		android:textSize="12sp"
		android:textStyle="bold"
		android:visibility="gone" />

</LinearLayout>
