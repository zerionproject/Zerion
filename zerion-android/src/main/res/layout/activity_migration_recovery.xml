<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true">

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="@dimen/margin_xlarge">

		<androidx.appcompat.widget.AppCompatImageView
			android:id="@+id/errorIcon"
			android:layout_width="@dimen/hero_square"
			android:layout_height="@dimen/hero_square"
			app:layout_constraintBottom_toTopOf="@+id/migrationTitle"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintVertical_bias="0.15"
			app:layout_constraintVertical_chainStyle="packed"
			app:srcCompat="@drawable/alerts_and_states_error"
			app:tint="@color/zerion_error_red"
			tools:ignore="ContentDescription" />

		<TextView
			android:id="@+id/migrationTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/margin_xlarge"
			android:gravity="center"
			android:text="@string/migration_title"
			android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
			app:layout_constraintBottom_toTopOf="@+id/migrationDescription"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/errorIcon" />

		<TextView
			android:id="@+id/migrationDescription"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:text="@string/migration_description"
			android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
			app:layout_constraintBottom_toTopOf="@+id/retryButton"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/migrationTitle" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/retryButton"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/margin_xlarge"
			android:text="@string/migration_retry"
			app:layout_constraintBottom_toTopOf="@+id/exportButton"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/migrationDescription" />

		<com.google.android.material.button.MaterialButton
			style="@style/Widget.MaterialComponents.Button.OutlinedButton"
			android:id="@+id/exportButton"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/migration_export"
			app:layout_constraintBottom_toTopOf="@+id/startFreshButton"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/retryButton" />

		<com.google.android.material.button.MaterialButton
			style="@style/Widget.MaterialComponents.Button.TextButton"
			android:id="@+id/startFreshButton"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/migration_start_fresh"
			android:textColor="@color/zerion_error_red"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/exportButton" />

	</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
