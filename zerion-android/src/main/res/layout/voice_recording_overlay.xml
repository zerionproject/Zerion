<?xml version="1.0" encoding="utf-8"?>
<!-- Voice recording mode - replaces normal input UI when recording -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voiceRecordingOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone">

    <!-- Recording controls bar - floating style matching input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- Cancel button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/cancel_recording_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancel recording"
            android:padding="10dp"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_close"
            app:tint="@color/zerion_destructive" />

        <!-- Recording pulse indicator -->
        <View
            android:id="@+id/recording_pulse"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ic_circle"
            android:backgroundTint="@color/zerion_destructive" />

        <!-- Timer -->
        <TextView
            android:id="@+id/recording_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="start" />

        <!-- Send button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/send_voice_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Send voice message"
            android:padding="10dp"
            android:scaleType="center"
            app:srcCompat="@drawable/social_send_now_white"
            app:tint="@color/zerion_primary_accent" />

    </LinearLayout>

</RelativeLayout>
