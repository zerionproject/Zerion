<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:saveEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/recovery_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/zerion_text_primary"
            android:contentDescription="@android:string/cancel" />

        <TextView
            android:id="@+id/recovery_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/wallet_xmr_phrase_title"
            android:textColor="@color/zerion_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:saveEnabled="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/recovery_phrase_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recovery_wallet_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/zerion_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/wallet_xmr_phrase_intro"
                    android:textColor="@color/zerion_text_primary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

                <LinearLayout
                    android:id="@+id/recovery_word_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recovery_verify"
                    style="@style/ZerionButton"
                    android:layout_marginTop="20dp"
                    android:text="@string/wallet_xmr_phrase_verify_action" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recovery_copy"
                    style="@style/ZerionButtonOutline.Neutral"
                    android:layout_marginTop="8dp"
                    android:text="@string/wallet_xmr_phrase_copy_action" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recovery_later"
                    style="@style/ZerionButtonFlat.Neutral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/wallet_xmr_phrase_later" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/recovery_verify_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wallet_xmr_phrase_verify_title"
                    android:textColor="@color/zerion_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recovery_verify_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/zerion_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/recovery_verify_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center"
                    android:textColor="@color/zerion_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recovery_chip_1"
                        style="@style/ZerionButtonOutline.Neutral"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recovery_chip_2"
                        style="@style/ZerionButtonOutline.Neutral"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recovery_chip_3"
                        style="@style/ZerionButtonOutline.Neutral"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recovery_chip_4"
                        style="@style/ZerionButtonOutline.Neutral"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recovery_chip_5"
                        style="@style/ZerionButtonOutline.Neutral"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/recovery_chip_6"
                        style="@style/ZerionButtonOutline.Neutral"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/recovery_verify_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:minHeight="20dp"
                    android:textColor="@color/zerion_red_500"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recovery_verify_cancel"
                    style="@style/ZerionButtonFlat.Neutral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@android:string/cancel" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
