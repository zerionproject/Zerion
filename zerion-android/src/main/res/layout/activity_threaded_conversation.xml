<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_zerion_gradient"
    tools:context=".android.forum.ForumActivity">

    <!-- TOP APP BAR - Modern 2025 Style -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_transparent"
        android:elevation="6dp"
        app:elevation="6dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Zerion.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:titleTextColor="@android:color/white"
            app:subtitleTextColor="@color/zerion_cyan"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- MAIN CONTENT WRAPPER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- MESSAGE LIST AREA WITH EDGE-TO-EDGE BEHAVIOR -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <com.professor.zerion.android.view.ZerionRecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:emptyText="@string/no_forum_posts"
                app:scrollToEnd="false" />

            <!-- UNREAD UP BUTTON -->
            <com.professor.zerion.android.view.UnreadMessageButton
                android:id="@+id/upButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="16dp"
                android:layout_gravity="top|end"
                app:direction="up" />

            <!-- UNREAD DOWN BUTTON -->
            <com.professor.zerion.android.view.UnreadMessageButton
                android:id="@+id/downButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="16dp"
                android:layout_gravity="bottom|end"
                app:direction="down" />

        </FrameLayout>

        <!-- MODERN FLOATING INPUT BAR -->
        <com.professor.zerion.android.view.TextInputView
            android:id="@+id/text_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_bar"
            android:elevation="8dp"
            android:clipToPadding="false" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
