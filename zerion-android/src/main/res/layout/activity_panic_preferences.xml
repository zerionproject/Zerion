<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient"
	android:fitsSystemWindows="true"
	android:orientation="vertical">

	<!-- Toolbar matching settings -->
	<com.google.android.material.appbar.AppBarLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/bg_toolbar_gradient"
		android:elevation="4dp">

		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/toolbar"
			style="@style/ZerionToolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="@android:color/transparent"
			android:elevation="0dp"
			app:titleTextColor="@color/zerion_text_primary"
			app:navigationIconTint="@color/zerion_cyan" />
	</com.google.android.material.appbar.AppBarLayout>

	<fragment
		android:id="@+id/fragment"
		android:name="com.professor.zerion.android.panic.PanicPreferencesFragment"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

</LinearLayout>
