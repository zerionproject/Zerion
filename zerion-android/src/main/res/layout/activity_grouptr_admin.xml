<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient"
	android:fitsSystemWindows="true"
	android:orientation="vertical">

	<com.google.android.material.appbar.AppBarLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/bg_toolbar_gradient">

		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/toolbar"
			style="@style/Zerion.Toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			app:navigationIcon="@drawable/ic_arrow_back"
			app:navigationContentDescription="@string/abc_action_bar_up_description"
			app:navigationIconTint="?attr/zerionColorOnSurface"
			app:title="@string/grouptr_group_settings"
			app:titleTextColor="?attr/zerionColorOnSurface" />

	</com.google.android.material.appbar.AppBarLayout>

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingBottom="32dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@android:color/transparent"
				android:gravity="center"
				android:orientation="vertical"
				android:padding="24dp">

				<TextView
					android:id="@+id/headerAvatar"
					android:layout_width="96dp"
					android:layout_height="96dp"
					android:background="@drawable/badge_circle_cyan"
					android:gravity="center"
					android:textColor="?attr/zerionColorOnAccent"
					android:textSize="34sp"
					android:textStyle="bold"
					tools:text="F" />

				<TextView
					android:id="@+id/headerName"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:accessibilityHeading="true"
					android:layout_marginTop="16dp"
					android:ellipsize="end"
					android:gravity="center"
					android:maxLines="2"
					android:textColor="?attr/zerionColorOnSurface"
					android:fontFamily="@font/bricolage_grotesque"
					android:textFontWeight="500"
					tools:text="Family"
					android:textAppearance="@style/TextAppearance.Zerion.Headline" />

				<TextView
					android:id="@+id/headerSubtitle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:ellipsize="end"
					android:gravity="center"
					android:maxLines="1"
					android:textColor="?attr/zerionColorOnSurfaceMuted"
					tools:text="4 members · End-to-end encrypted"
					android:textAppearance="@style/TextAppearance.Zerion.Caption" />

			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="16dp"
				android:layout_marginEnd="16dp"
				android:background="@drawable/bg_contact_card"
				android:orientation="vertical"
				android:padding="8dp">

				<TextView
					android:id="@+id/membersHeader"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:accessibilityHeading="true"
					android:padding="16dp"
					android:textColor="?attr/zerionColorOnSurface"
					tools:text="Members (4)"
					android:textAppearance="@style/TextAppearance.Zerion.Body.Strong" />

				<LinearLayout
					android:id="@+id/membersContainer"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingBottom="4dp" />

			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="16dp"
				android:layout_marginEnd="16dp"
				android:layout_marginTop="16dp"
				android:background="@drawable/bg_contact_card"
				android:orientation="vertical"
				android:padding="8dp">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:accessibilityHeading="true"
					android:padding="16dp"
					android:text="@string/grouptr_admin_section_group_settings"
					android:textColor="?attr/zerionColorOnSurface"
					android:textAppearance="@style/TextAppearance.Zerion.Body.Strong" />

				<LinearLayout
					android:id="@+id/actionAddMember"
					style="@style/GroupTrAdminActionRow">

					<ImageView
						style="@style/GroupTrAdminActionIcon"
						android:src="@drawable/ic_person_add"
						android:contentDescription="@null"
						app:tint="?attr/zerionColorAccentIcon" />

					<TextView
						style="@style/GroupTrAdminActionText"
						android:text="@string/grouptr_add_member" />

				</LinearLayout>

				<LinearLayout
					android:id="@+id/rowMembersMayInvite"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingHorizontal="20dp"
					android:paddingVertical="8dp"
					android:visibility="gone">

					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/membersMayInviteSwitch"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="48dp"
						android:text="@string/grouptr_members_may_invite"
						android:textColor="?attr/zerionColorOnSurface"
						android:textAppearance="@style/TextAppearance.Zerion.Body" />

					<TextView
						android:id="@+id/membersMayInviteSummary"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/grouptr_members_may_invite_summary"
						android:textColor="?attr/zerionColorOnSurfaceMuted"
						android:textAppearance="@style/TextAppearance.Zerion.Meta" />

				</LinearLayout>

				<LinearLayout
					android:id="@+id/actionInviteContacts"
					style="@style/GroupTrAdminActionRow"
					android:minHeight="52dp"
					android:visibility="gone">

					<ImageView
						style="@style/GroupTrAdminActionIcon"
						android:src="@drawable/ic_person_add"
						android:contentDescription="@null"
						app:tint="?attr/zerionColorAccentIcon" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:id="@+id/actionInviteContactsText"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/grouptr_invite_contacts"
							android:textColor="?attr/zerionColorOnSurface"
							android:textAppearance="@style/TextAppearance.Zerion.Body" />

						<TextView
							android:id="@+id/actionInviteContactsHint"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:textColor="?attr/zerionColorOnSurfaceMuted"
							android:visibility="gone"
							android:textAppearance="@style/TextAppearance.Zerion.Meta" />

					</LinearLayout>

				</LinearLayout>

				<LinearLayout
					android:id="@+id/rowIncognito"
					style="@style/GroupTrAdminActionRow"
					android:minHeight="52dp"
					android:visibility="gone">

					<ImageView
						style="@style/GroupTrAdminActionIcon"
						android:src="@drawable/ic_lock"
						android:contentDescription="@null"
						app:tint="?attr/zerionColorAccentIcon" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/grouptr_incognito"
							android:textColor="?attr/zerionColorOnSurface"
							android:textAppearance="@style/TextAppearance.Zerion.Body" />

						<TextView
							android:id="@+id/incognitoNameText"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:textColor="?attr/zerionColorOnSurfaceMuted"
							android:textAppearance="@style/TextAppearance.Zerion.Meta" />

					</LinearLayout>

				</LinearLayout>

				<LinearLayout
					android:id="@+id/rowOlderGroup"
					style="@style/GroupTrAdminActionRow"
					android:minHeight="52dp"
					android:visibility="gone">

					<ImageView
						style="@style/GroupTrAdminActionIcon"
						android:src="@drawable/ic_lock"
						android:contentDescription="@null"
						app:tint="?attr/zerionColorAccentIcon" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/grouptr_create_new_private_group"
							android:textColor="?attr/zerionColorOnSurface"
							android:textAppearance="@style/TextAppearance.Zerion.Body" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:text="@string/grouptr_older_group_note"
							android:textColor="?attr/zerionColorOnSurfaceMuted"
							android:textAppearance="@style/TextAppearance.Zerion.Meta" />

					</LinearLayout>

				</LinearLayout>

				<LinearLayout
					android:id="@+id/actionStealth"
					style="@style/GroupTrAdminActionRow"
					android:visibility="gone">

					<ImageView
						style="@style/GroupTrAdminActionIcon"
						android:src="@drawable/ic_lock"
						android:contentDescription="@null"
						app:tint="?attr/zerionColorAccentIcon" />

					<TextView
						style="@style/GroupTrAdminActionText"
						android:text="@string/grouptr_stealth_name_set" />

				</LinearLayout>

				<LinearLayout
					android:id="@+id/actionTtl"
					style="@style/GroupTrAdminActionRow">

					<ImageView
						style="@style/GroupTrAdminActionIcon"
						android:src="@drawable/ic_timer"
						android:contentDescription="@null"
						app:tint="?attr/zerionColorAccentIcon" />

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/grouptr_default_ttl_set"
							android:textColor="?attr/zerionColorOnSurface"
							android:textAppearance="@style/TextAppearance.Zerion.Body" />

						<TextView
							android:id="@+id/actionTtlText"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="2dp"
							android:textColor="?attr/zerionColorOnSurfaceMuted"
							tools:text="Off"
							android:textAppearance="@style/TextAppearance.Zerion.Meta" />

					</LinearLayout>

				</LinearLayout>

			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="16dp"
				android:layout_marginEnd="16dp"
				android:layout_marginTop="16dp"
				android:background="@drawable/bg_contact_card"
				android:orientation="vertical"
				android:padding="8dp">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:accessibilityHeading="true"
					android:padding="16dp"
					android:text="@string/grouptr_admin_section_danger"
					android:textColor="?attr/zerionColorDangerText"
					android:textAppearance="@style/TextAppearance.Zerion.Body.Strong" />

				<LinearLayout
					android:id="@+id/dangerContainer"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingBottom="4dp" />

			</LinearLayout>

			<com.google.android.material.button.MaterialButton
				android:id="@+id/openChatButton"
				style="@style/Widget.Material3.Button"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:layout_marginStart="16dp"
				android:layout_marginEnd="16dp"
				android:layout_marginTop="24dp"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:text="@string/grouptr_open_chat"
				android:textColor="@color/zerion_button_filled_foreground"
				app:backgroundTint="@color/zerion_button_filled_background"
				app:cornerRadius="24dp"
				app:icon="@drawable/ic_chat"
				app:iconGravity="textStart"
				app:iconPadding="8dp"
				app:iconTint="@color/zerion_button_filled_foreground"
				android:textAppearance="@style/TextAppearance.Zerion.Body.Strong" />

		</LinearLayout>

	</ScrollView>

</LinearLayout>
