<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingTop="@dimen/message_bubble_margin"
	android:paddingBottom="@dimen/message_bubble_margin">

	<LinearLayout
		android:id="@+id/commentCard"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="start"
		android:layout_marginStart="@dimen/message_bubble_margin_tail"
		android:layout_marginEnd="@dimen/message_bubble_margin_non_tail"
		android:background="@drawable/msg_in"
		android:elevation="@dimen/message_bubble_elevation"
		android:minWidth="@dimen/reply_quote_min_width"
		android:orientation="vertical">

		<LinearLayout
			android:id="@+id/commentHeader"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/commentAuthor"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="1"
				android:minHeight="48dp"
				android:gravity="center_vertical"
				android:textColor="@color/selectable_accent_text"
				tools:text="Hans"
				android:textAppearance="@style/TextAppearance.Zerion.Label" />

			<TextView
				android:id="@+id/commentAuthorTag"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				android:maxLines="1"
				android:textColor="@color/selectable_on_bubble_in_muted"
				android:visibility="gone"
				tools:text="Owner"
				tools:visibility="visible"
				android:textAppearance="@style/TextAppearance.Zerion.Meta.Strong" />

		</LinearLayout>

		<TextView
			android:id="@+id/commentBody"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="-6dp"
			android:textColor="?attr/zerionColorOnBubbleIn"
			android:textColorLink="@color/selectable_accent_text"
			tools:text="Great post!"
			android:textAppearance="@style/TextAppearance.Zerion.Body" />

		<TextView
			android:id="@+id/commentStateReason"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:textColor="@color/selectable_on_bubble_in_muted"
			android:visibility="gone"
			tools:text="@string/channels_queued_no_access"
			tools:visibility="visible"
			android:textAppearance="@style/TextAppearance.Zerion.Caption" />

		<TextView
			android:id="@+id/commentTimestamp"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end"
			android:layout_marginTop="4dp"
			android:gravity="center_vertical"
			android:maxLines="1"
			android:textColor="@color/selectable_on_bubble_in_muted"
			tools:text="14:00"
			android:textAppearance="@style/TextAppearance.Zerion.Meta" />

	</LinearLayout>

	<include
		layout="@layout/view_message_not_sent_actions"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="end"
		android:layout_marginEnd="@dimen/message_bubble_margin_tail"
		android:layout_marginTop="2dp" />

</LinearLayout>
