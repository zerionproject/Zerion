<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient"
	android:orientation="vertical">

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="@dimen/margin_large">

			<TextView
				android:id="@+id/invitesPausedBanner"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="?attr/zerionColorSurfaceVariant"
				android:clickable="true"
				android:focusable="true"
				android:gravity="center_vertical"
				android:minHeight="48dp"
				android:padding="12dp"
				android:textColor="@color/zerion_text_primary"
				android:textSize="14sp"
				android:visibility="gone" />

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/inviteLinkLayout"
				style="@style/Zerion.TextInput"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:hint="@string/send_invite_link_hint"
				app:errorEnabled="true"
				app:errorAccessibilityLiveRegion="1">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/inviteLinkInput"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textColor="@color/zerion_text_primary"
					android:imeOptions="flagNoPersonalizedLearning"
					android:privateImeOptions="nm"
					android:importantForAutofill="no"
					android:inputType="textUri|textNoSuggestions" />

			</com.google.android.material.textfield.TextInputLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="end"
				android:orientation="horizontal">

				<com.google.android.material.button.MaterialButton
					android:id="@+id/invitePasteButton"
					style="@style/Zerion.Button.Text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/paste_button"
					app:icon="@drawable/ic_content_paste"
					app:iconPadding="8dp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/inviteScanButton"
					style="@style/Zerion.Button.Text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/send_invite_scan_button"
					app:icon="@drawable/ic_camera_24dp"
					app:iconPadding="8dp" />

			</LinearLayout>

			<TextView
				android:id="@+id/inviteNotice"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:accessibilityLiveRegion="polite"
				android:textColor="@color/zerion_text_primary"
				android:textSize="14sp"
				android:visibility="gone" />

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/inviteAliasLayout"
				style="@style/Zerion.TextInput"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:hint="@string/send_invite_alias_hint"
				app:errorEnabled="true"
				app:errorAccessibilityLiveRegion="1">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/inviteAliasInput"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textColor="@color/zerion_text_primary"
					android:imeOptions="flagNoPersonalizedLearning"
					android:importantForAutofill="no"
					android:inputType="textPersonName" />

			</com.google.android.material.textfield.TextInputLayout>

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/inviteShownNameLayout"
				style="@style/Zerion.TextInput"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:hint="@string/send_invite_shown_name_hint"
				app:errorEnabled="true"
				app:errorAccessibilityLiveRegion="1">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/inviteShownNameInput"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textColor="@color/zerion_text_primary"
					android:imeOptions="flagNoPersonalizedLearning"
					android:importantForAutofill="no"
					android:inputType="textPersonName" />

			</com.google.android.material.textfield.TextInputLayout>

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/inviteNoteLayout"
				style="@style/Zerion.TextInput"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:hint="@string/send_invite_note_hint"
				app:counterEnabled="true"
				app:helperText="@string/send_invite_note_info"
				app:helperTextEnabled="true"
				app:errorEnabled="true"
				app:errorAccessibilityLiveRegion="1">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/inviteNoteInput"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:textColor="@color/zerion_text_primary"
					android:imeOptions="flagNoPersonalizedLearning"
					android:importantForAutofill="no"
					android:inputType="textMultiLine|textCapSentences" />

			</com.google.android.material.textfield.TextInputLayout>

			<TextView
				style="@style/Zerion.Settings.SectionHeader"
				android:layout_marginStart="0dp"
				android:layout_marginTop="28dp"
				android:text="@string/zero_id_title" />

			<TextView
				android:id="@+id/zeroIdInfo"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/zero_id_info"
				android:textColor="@color/zerion_text_secondary"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/zeroIdRotatesInfo"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="@string/zero_id_rotates_info"
				android:textColor="@color/zerion_text_secondary"
				android:textSize="14sp" />

			<TextView
				android:id="@+id/zeroIdView"
				android:contentDescription="@string/zero_id_link_description"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:background="@drawable/bg_link_exchange_field"
				android:ellipsize="end"
				android:fontFamily="@font/plex_mono_regular"
				android:paddingHorizontal="14dp"
				android:paddingVertical="14dp"
				android:singleLine="true"
				android:textColor="@color/zerion_accent_text"
				android:textSize="14sp" />

			<androidx.constraintlayout.widget.ConstraintLayout
				android:id="@+id/zeroIdActions"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">

				<com.google.android.material.button.MaterialButton
					android:id="@+id/zeroIdShareButton"
					style="@style/Zerion.Button.Text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:enabled="false"
					android:text="@string/share_button" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/zeroIdCopyButton"
					style="@style/Zerion.Button.Text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:enabled="false"
					android:text="@string/copy_button" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/zeroIdQrButton"
					style="@style/Zerion.Button.Text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:enabled="false"
					android:text="@string/show_qr_button" />

				<androidx.constraintlayout.helper.widget.Flow
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					app:constraint_referenced_ids="zeroIdShareButton,zeroIdCopyButton,zeroIdQrButton"
					app:flow_horizontalBias="0.5"
					app:flow_horizontalGap="4dp"
					app:flow_horizontalStyle="packed"
					app:flow_wrapMode="chain"
					app:layout_constraintEnd_toEndOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintTop_toTopOf="parent" />

			</androidx.constraintlayout.widget.ConstraintLayout>

			<com.google.android.material.button.MaterialButton
				android:id="@+id/inviteLinksButton"
				style="@style/Zerion.Button.Text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal"
				android:text="@string/invite_links_title" />

		</LinearLayout>
	</ScrollView>

	<com.google.android.material.button.MaterialButton
		android:id="@+id/inviteSendButton"
		style="@style/Zerion.Button.Primary"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginBottom="16dp"
		android:text="@string/send_invite_send_button" />

</LinearLayout>
