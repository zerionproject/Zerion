<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingHorizontal="24dp"
	android:paddingTop="16dp">

	<com.google.android.material.textfield.TextInputLayout
		android:id="@+id/requestAcceptNameLayout"
		style="@style/Zerion.TextInput"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:hint="@string/send_invite_alias_hint"
		app:errorEnabled="true"
		app:errorAccessibilityLiveRegion="1">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/requestAcceptName"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textColor="@color/zerion_text_primary"
			android:imeOptions="flagNoPersonalizedLearning"
			android:importantForAutofill="no"
			android:inputType="textPersonName" />

	</com.google.android.material.textfield.TextInputLayout>

</FrameLayout>
