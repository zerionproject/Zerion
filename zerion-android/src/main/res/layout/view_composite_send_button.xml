<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="wrap_content"
	android:layout_height="48dp"
	android:layout_gravity="bottom"
	android:orientation="horizontal"
	android:gravity="center_vertical"
	tools:parentTag="com.professor.zerion.android.view.CompositeSendButton"
	tools:showIn="@layout/text_input_view">

	<FrameLayout
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_marginStart="0dp">

		<androidx.appcompat.widget.AppCompatImageButton
			android:id="@+id/voiceButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="?attr/selectableItemBackground"
			android:clickable="true"
			android:contentDescription="@string/record_voice_message"
			android:enabled="true"
			android:focusable="true"
			android:padding="12dp"
			android:scaleType="center"
			android:visibility="visible"
			app:srcCompat="@drawable/ic_mic_24dp"
			app:tint="?attr/zerionColorAccentIcon" />

		<androidx.appcompat.widget.AppCompatImageButton
			android:id="@+id/sendButton"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="?attr/selectableItemBackground"
			android:clickable="true"
			android:contentDescription="@string/send"
			android:enabled="false"
			android:focusable="true"
			android:padding="12dp"
			android:scaleType="center"
			android:visibility="invisible"
			app:srcCompat="@drawable/social_send_now_white"
			app:tint="?attr/zerionColorAccentIcon" />

		<ImageView
			android:id="@+id/bombBadge"
			android:layout_width="16dp"
			android:layout_height="16dp"
			android:importantForAccessibility="no"
			android:layout_gravity="top|end"
			android:layout_marginTop="3dp"
			android:layout_marginEnd="3dp"
			android:visibility="invisible"
			app:srcCompat="@drawable/ic_bomb"
			app:tint="?attr/zerionColorWarning" />

		<ProgressBar
			android:id="@+id/progressBar"
			style="@style/Zerion.Progress.Circular"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:layout_gravity="center"
			android:visibility="invisible" />

	</FrameLayout>

</LinearLayout>