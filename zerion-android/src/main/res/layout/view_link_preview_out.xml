<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linkPreviewCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/zerionColorBubbleOutInset"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/linkPreviewImage"
            app:tint="@color/selected_media"
            app:tintMode="src_atop"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/linkPreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/zerionColorOnBubbleOut"
                android:maxLines="2"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.Zerion.Label" />

            <TextView
                android:id="@+id/linkPreviewDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/zerionColorOnBubbleOutMuted"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:visibility="gone"
                android:textAppearance="@style/TextAppearance.Zerion.Meta" />

            <TextView
                android:id="@+id/linkPreviewDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/zerionColorOnBubbleOutMuted"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Zerion.Meta" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
