<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient">

	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/app_bar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/bg_toolbar_gradient"
		android:elevation="0dp"
		android:fitsSystemWindows="true"
		app:elevation="0dp">

		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="@android:color/transparent"
			app:navigationIcon="@drawable/ic_back"
			app:navigationIconTint="@color/zerion_text_primary"
			app:title="New Document"
			app:titleTextColor="@color/zerion_text_primary"
			app:titleCentered="true"
			app:menu="@menu/text_editor_menu" />

	</com.google.android.material.appbar.AppBarLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="16dp"
			android:paddingEnd="16dp"
			android:paddingTop="16dp">

			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				app:cardBackgroundColor="@color/zerion_surface_elevated"
				app:cardCornerRadius="12dp"
				app:cardElevation="2dp"
				app:strokeWidth="0dp">

				<com.google.android.material.textfield.TextInputLayout
					android:id="@+id/document_name_layout"
					style="@style/Zerion.TextInput.Outlined"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_margin="12dp"
					android:hint="Document Name"
					app:boxBackgroundColor="@android:color/transparent"
					app:boxStrokeColor="@color/zerion_primary_accent"
					app:boxStrokeWidth="2dp"
					app:boxCornerRadiusTopStart="8dp"
					app:boxCornerRadiusTopEnd="8dp"
					app:boxCornerRadiusBottomStart="8dp"
					app:boxCornerRadiusBottomEnd="8dp"
					app:hintTextColor="@color/zerion_primary_accent"
					app:errorEnabled="true">

					<com.google.android.material.textfield.TextInputEditText
						android:id="@+id/document_name_input"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:inputType="text|textNoSuggestions"
						android:maxLines="1"
						android:textColor="@color/zerion_text_primary"
						android:textColorHint="@color/zerion_hint"
						android:textSize="16sp"
						android:imeOptions="flagNoPersonalizedLearning|actionNext"
						android:privateImeOptions="nm"
						android:importantForAutofill="no"
						android:paddingTop="16dp"
						android:paddingBottom="16dp" />

				</com.google.android.material.textfield.TextInputLayout>

			</com.google.android.material.card.MaterialCardView>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="end"
				android:layout_marginBottom="12dp"
				android:paddingStart="4dp"
				android:paddingEnd="4dp">

				<com.google.android.material.button.MaterialButton
					android:id="@+id/toggle_monospace"
					style="@style/Zerion.Button.Text"
					android:layout_width="wrap_content"
					android:layout_height="48dp"
					android:text="@string/text_editor_monospace"
					android:textSize="12sp"
					android:minWidth="0dp"
					android:paddingStart="12dp"
					android:paddingEnd="12dp"
					app:icon="@drawable/ic_text"
					app:iconSize="18dp"
					app:iconGravity="textStart"
					app:iconPadding="4dp"
					app:iconTint="@color/zerion_primary_accent" />

				<TextView
					android:id="@+id/word_count"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="center_vertical"
					android:layout_marginStart="12dp"
					tools:text="0 words"
					android:textColor="@color/zerion_text_secondary"
					android:textSize="12sp" />

			</LinearLayout>

		</LinearLayout>

		<com.google.android.material.card.MaterialCardView
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:layout_marginStart="16dp"
			android:layout_marginEnd="16dp"
			android:layout_marginBottom="16dp"
			app:cardBackgroundColor="@color/zerion_surface_elevated"
			app:cardCornerRadius="12dp"
			app:cardElevation="2dp"
			app:strokeWidth="0dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:padding="12dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/text_editor_content"
					android:textColor="@color/zerion_primary_accent"
					android:textSize="12sp"
					android:layout_marginBottom="8dp"
					android:paddingStart="4dp" />

				<androidx.core.widget.NestedScrollView
					android:layout_width="match_parent"
					android:layout_height="0dp"
					android:layout_weight="1"
					android:fillViewport="true"
					android:scrollbars="vertical"
					android:fadeScrollbars="false">

					<com.google.android.material.textfield.TextInputEditText
						android:id="@+id/document_content_input"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:inputType="textMultiLine|textNoSuggestions|textCapSentences"
						android:gravity="top|start"
						android:background="@android:color/transparent"
						android:textColor="@color/zerion_text_primary"
						android:textColorHint="@color/zerion_hint"
						android:hint="Start writing..."
						android:textSize="15sp"
						android:lineSpacingMultiplier="1.4"
						android:padding="12dp"
						android:imeOptions="flagNoPersonalizedLearning|flagNoExtractUi"
						android:privateImeOptions="nm"
						android:importantForAutofill="no" />

				</androidx.core.widget.NestedScrollView>

			</LinearLayout>

		</com.google.android.material.card.MaterialCardView>

	</LinearLayout>

	<com.google.android.material.floatingactionbutton.FloatingActionButton
		android:id="@+id/fab_save"
		android:layout_width="56dp"
		android:layout_height="56dp"
		android:layout_gravity="bottom|end"
		android:layout_margin="16dp"
		android:contentDescription="@string/cd_save_document"
		app:backgroundTint="@color/zerion_primary_accent"
		app:tint="@android:color/white"
		app:elevation="6dp"
		app:hoveredFocusedTranslationZ="8dp"
		app:pressedTranslationZ="12dp"
		app:srcCompat="@drawable/ic_check_circle" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
