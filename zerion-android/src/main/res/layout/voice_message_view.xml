<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal"
	android:paddingStart="12dp"
	android:paddingEnd="12dp"
	android:paddingTop="8dp"
	android:paddingBottom="8dp"
	android:gravity="center_vertical"
	android:minHeight="60dp">

	<!-- Play/Pause Button -->
	<com.google.android.material.button.MaterialButton
		android:id="@+id/playPauseButton"
		style="@style/Widget.MaterialComponents.Button.Icon"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:backgroundTint="?attr/colorPrimary"
		android:insetTop="0dp"
		android:insetBottom="0dp"
		android:padding="0dp"
		app:icon="@drawable/ic_play_arrow_24dp"
		app:iconTint="@android:color/white"
		app:iconGravity="textStart"
		app:iconPadding="0dp"
		app:cornerRadius="20dp"
		android:contentDescription="@string/play_voice_message" />

	<!-- Waveform/Progress Container -->
	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:layout_marginStart="12dp"
		android:layout_marginEnd="4dp"
		android:orientation="vertical">

		<!-- Progress SeekBar with improved styling -->
		<SeekBar
			android:id="@+id/voiceProgress"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:progressTint="?attr/colorPrimary"
			android:thumbTint="?attr/colorPrimary"
			android:progressBackgroundTint="?attr/colorControlHighlight"
			android:max="100"
			android:progress="0"
			android:paddingStart="0dp"
			android:paddingEnd="0dp"
			android:minHeight="24dp" />

		<!-- Duration Label -->
		<TextView
			android:id="@+id/voiceDuration"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="12sp"
			android:textColor="@color/zerion_text_secondary_inverse"
			android:fontFamily="sans-serif"
			android:layout_marginTop="2dp"
			android:layout_marginStart="2dp"
			android:text="@string/voice_message_loading" />
	</LinearLayout>

</LinearLayout>
