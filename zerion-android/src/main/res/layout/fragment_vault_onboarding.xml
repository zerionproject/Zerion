<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_zerion_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:id="@+id/vault_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vault_name"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/zerion_primary_accent"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/vault_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vault_onboarding_subtitle"
            android:textSize="16sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginBottom="24dp"
            android:gravity="center" />

        <!-- Security Features Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/features_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            style="@style/Zerion.Card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/vault_onboarding_features"
                    android:textSize="13sp"
                    android:textColor="#B3FFFFFF"
                    android:gravity="center" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Password Creation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vault_onboarding_create_password"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp" />

        <!-- Password Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/vault_onboarding_password_hint"
            app:passwordToggleEnabled="true"
            app:endIconMode="password_toggle"
            app:helperText="@string/vault_onboarding_password_helper"
            style="@style/Zerion.TextInput.Outlined"
            android:layout_marginBottom="16dp">

            <com.professor.zerion.android.vault.ui.SecurePasswordEditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@android:color/white"
                android:imeOptions="flagNoPersonalizedLearning"
                android:privateImeOptions="nm"
                android:importantForAutofill="no"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/confirm_password_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/vault_onboarding_confirm_password_hint"
            app:passwordToggleEnabled="true"
            app:endIconMode="password_toggle"
            style="@style/Zerion.TextInput.Outlined"
            android:layout_marginBottom="24dp">

            <com.professor.zerion.android.vault.ui.SecurePasswordEditText
                android:id="@+id/confirm_password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@android:color/white"
                android:imeOptions="flagNoPersonalizedLearning"
                android:privateImeOptions="nm"
                android:importantForAutofill="no"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Warning Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFF3CD"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/vault_onboarding_warning"
                    android:textSize="13sp"
                    android:textColor="#856404" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Create Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_vault_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/vault_onboarding_create_button"
            android:textSize="16sp"
            android:enabled="false"
            style="@style/Zerion.Button.Primary"
            app:cornerRadius="8dp" />

    </LinearLayout>

</ScrollView>