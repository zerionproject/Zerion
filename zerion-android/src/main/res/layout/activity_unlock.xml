<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient"
	android:fitsSystemWindows="true"
	android:orientation="vertical"
	tools:context=".android.account.UnlockActivity">

	<androidx.appcompat.widget.AppCompatImageView
		android:id="@+id/image"
		android:layout_width="100dp"
		android:layout_height="100dp"
		app:layout_constraintBottom_toTopOf="@+id/lockBadge"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintVertical_bias="0.18"
		app:layout_constraintVertical_chainStyle="packed"
		app:srcCompat="@drawable/splash_screen" />

	<FrameLayout
		android:id="@+id/lockBadge"
		android:layout_width="112dp"
		android:layout_height="112dp"
		android:layout_marginTop="40dp"
		android:background="@drawable/bg_unlock_fingerprint_badge"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/image"
		app:layout_constraintBottom_toTopOf="@+id/unlockText">

		<ImageView
			android:id="@+id/lockIcon"
			android:layout_width="56dp"
			android:layout_height="56dp"
			android:layout_gravity="center"
			android:scaleType="center"
			app:srcCompat="@drawable/ic_fingerprint"
			app:tint="@color/zerion_primary_accent"
			tools:ignore="ContentDescription" />

	</FrameLayout>

	<TextView
		android:id="@+id/unlockText"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="28dp"
		android:gravity="center"
		android:paddingHorizontal="32dp"
		android:text="@string/lock_unlock"
		android:textColor="#FFFFFF"
		android:textSize="22sp"
		android:textStyle="bold"
		android:letterSpacing="0.01"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/lockBadge"
		app:layout_constraintBottom_toTopOf="@+id/unlockSubtext" />

	<TextView
		android:id="@+id/unlockSubtext"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:gravity="center"
		android:paddingHorizontal="40dp"
		android:text="@string/unlock_subtitle"
		android:textColor="#B3FFFFFF"
		android:textSize="14sp"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toBottomOf="@+id/unlockText"
		app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
