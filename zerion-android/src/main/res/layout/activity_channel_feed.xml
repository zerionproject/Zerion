<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/zerionColorBackground"
	android:fitsSystemWindows="true">

	<androidx.appcompat.widget.Toolbar
		android:id="@+id/channelFeedToolbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="?attr/actionBarSize"
		android:paddingTop="4dp"
		android:paddingBottom="4dp"
		android:background="?attr/zerionColorBackground"
		app:buttonGravity="center_vertical"
		app:layout_constraintTop_toTopOf="parent"
		app:titleMarginBottom="0dp"
		app:titleMarginTop="0dp"
		app:titleTextColor="?attr/zerionColorOnSurface"
		app:subtitleTextColor="?attr/zerionColorOnSurfaceMuted"
		tools:title="Civil Society Watch"
		tools:subtitle="Public channel" />

	<LinearLayout
		android:id="@+id/channelPinnedBanner"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="?attr/selectableItemBackground"
		android:clickable="true"
		android:focusable="true"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="16dp"
		android:paddingEnd="8dp"
		android:paddingTop="10dp"
		android:paddingBottom="10dp"
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@+id/channelFeedToolbar"
		tools:visibility="visible">

		<View
			android:layout_width="3dp"
			android:layout_height="32dp"
			android:layout_marginEnd="10dp"
			android:background="?attr/zerionColorAccentIcon" />

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/channels_pinned_label"
				android:textColor="?attr/zerionColorAccentText"
				android:textAppearance="@style/TextAppearance.Zerion.Meta.Strong" />

			<TextView
				android:id="@+id/channelPinnedBannerText"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="1"
				android:textColor="?attr/zerionColorOnSurface"
				tools:text="Today's notes: the new disclosure rules drop on Friday."
				android:textAppearance="@style/TextAppearance.Zerion.BodySmall" />

		</LinearLayout>

		<ImageButton
			android:id="@+id/channelPinnedBannerClose"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_marginTop="-4dp"
			android:layout_marginBottom="-4dp"
			android:layout_marginEnd="-4dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/channels_action_unpin"
			android:padding="14dp"
			android:src="@drawable/ic_close"
			android:visibility="gone"
			app:tint="?attr/zerionColorOnSurfaceMuted"
			tools:visibility="visible" />

	</LinearLayout>

	<TextView
		android:id="@+id/channelApprovalBanner"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="?attr/zerionColorAccent"
		android:gravity="center_vertical"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:paddingTop="10dp"
		android:paddingBottom="10dp"
		android:textColor="?attr/zerionColorOnAccent"
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@+id/channelPinnedBanner"
		tools:text="@string/channels_waiting_for_approval_banner"
		tools:visibility="visible"
		android:textAppearance="@style/TextAppearance.Zerion.Caption" />

	<TextView
		android:id="@+id/channelNoticeBanner"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="?attr/zerionColorBackground"
		android:gravity="center_vertical"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:paddingTop="8dp"
		android:paddingBottom="8dp"
		android:textColor="?attr/zerionColorOnSurfaceMuted"
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@+id/channelApprovalBanner"
		tools:text="@string/channels_posts_given_up_notice"
		tools:visibility="visible"
		android:textAppearance="@style/TextAppearance.Zerion.Caption" />

	<TextView
		android:id="@+id/channelSyncStatusLine"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="?attr/zerionColorBackground"
		android:gravity="center"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:paddingTop="4dp"
		android:paddingBottom="4dp"
		android:textColor="?attr/zerionColorOnSurfaceMuted"
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@+id/channelNoticeBanner"
		tools:text="Last updated 14:02"
		tools:visibility="visible"
		android:textAppearance="@style/TextAppearance.Zerion.Meta" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/channelFeedRecycler"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:clipToPadding="false"
		android:paddingTop="6dp"
		android:paddingBottom="12dp"
		android:scrollbars="none"
		app:layout_constraintBottom_toTopOf="@+id/channelFeedReadOnlyFooter"
		app:layout_constraintTop_toBottomOf="@+id/channelSyncStatusLine" />

	<TextView
		android:id="@+id/channelFeedReadOnlyFooter"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="?attr/zerionColorBackground"
		android:gravity="center"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:paddingTop="14dp"
		android:paddingBottom="18dp"
		android:text="@string/channels_feed_read_only_footer"
		android:textColor="?attr/zerionColorOnSurfaceMuted"
		android:visibility="gone"
		app:layout_constraintBottom_toTopOf="@+id/channelComposeBar"
		tools:visibility="visible"
		android:textAppearance="@style/TextAppearance.Zerion.Caption" />

	<TextView
		android:id="@+id/channelFeedEmptyView"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:paddingStart="32dp"
		android:paddingEnd="32dp"
		android:paddingTop="64dp"
		android:textColor="?attr/zerionColorOnSurfaceMuted"
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@+id/channelApprovalBanner"
		app:layout_constraintBottom_toTopOf="@+id/channelComposeBar"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		tools:text="@string/channels_feed_empty_subscriber"
		tools:visibility="visible"
		android:textAppearance="@style/TextAppearance.Zerion.Body" />

	<ProgressBar
		android:id="@+id/channelFeedProgress"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:indeterminate="true"
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@+id/channelApprovalBanner"
		app:layout_constraintBottom_toTopOf="@+id/channelComposeBar"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent" />

	<TextView
		android:id="@+id/channelFeedConnectingText"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		android:gravity="center"
		android:paddingStart="40dp"
		android:paddingEnd="40dp"
		android:textColor="?attr/zerionColorOnSurfaceMuted"
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@+id/channelFeedProgress"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		tools:text="@string/channels_feed_connecting"
		tools:visibility="visible"
		android:textAppearance="@style/TextAppearance.Zerion.BodySmall" />

	<com.professor.zerion.android.view.WrapRow
		android:id="@+id/channelComposeBar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:paddingStart="8dp"
		android:paddingEnd="12dp"
		android:paddingTop="10dp"
		android:paddingBottom="14dp"
		android:gravity="center_vertical"
		android:background="?attr/zerionColorBackground"
		android:visibility="gone"
		app:layout_constraintBottom_toBottomOf="parent"
		tools:visibility="visible">

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:orientation="horizontal">

			<ImageButton
				android:id="@+id/channelComposeTtlButton"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/channels_ttl_picker_cd"
				android:padding="12dp"
				android:src="@drawable/ic_timer"
				app:tint="?attr/zerionColorOnSurfaceMuted" />

			<ImageButton
				android:id="@+id/channelComposeAttachButton"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/channels_attach_cd"
				android:padding="12dp"
				android:src="@drawable/ic_attach"
				app:tint="?attr/zerionColorOnSurfaceMuted" />

		</LinearLayout>

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:layout_weight="1"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<EditText
				android:id="@+id/channelComposeInput"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:background="@drawable/text_input_background"
				android:hint="@string/channels_compose_hint"
				android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
				android:maxLength="4096"
				android:maxLines="4"
				android:minHeight="48dp"
				android:paddingStart="16dp"
				android:paddingEnd="16dp"
				android:paddingTop="12dp"
				android:paddingBottom="12dp"
				android:textColor="?attr/zerionColorOnSurface"
				android:textColorHint="?attr/zerionColorOnSurfaceMuted"
				android:importantForAutofill="no"
				android:textAppearance="@style/TextAppearance.Zerion.Body" />

			<ImageButton
				android:id="@+id/channelComposeSendButton"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_marginStart="8dp"
				android:background="@drawable/bg_chat_avatar"
				android:contentDescription="@string/channels_compose_send"
				android:padding="12dp"
				android:scaleType="center"
				android:src="@drawable/social_send_now_white"
				app:tint="?attr/zerionColorOnAccent" />

			<ProgressBar
				android:id="@+id/channelComposeProgress"
				style="?android:attr/progressBarStyleSmall"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:layout_marginStart="4dp"
				android:indeterminate="true"
				android:visibility="gone"
				tools:visibility="gone" />

		</LinearLayout>

	</com.professor.zerion.android.view.WrapRow>

</androidx.constraintlayout.widget.ConstraintLayout>
