<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/window_background"
	android:fitsSystemWindows="true">

	<androidx.appcompat.widget.Toolbar
		android:id="@+id/channelFeedToolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		android:background="@color/window_background"
		app:layout_constraintTop_toTopOf="parent"
		app:titleTextColor="@color/zerion_text_primary"
		app:subtitleTextColor="@color/zerion_text_secondary"
		tools:title="Civil Society Watch"
		tools:subtitle="Public channel" />

	<LinearLayout
		android:id="@+id/channelPinnedBanner"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="?attr/selectableItemBackground"
		android:clickable="true"
		android:focusable="true"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="16dp"
		android:paddingEnd="8dp"
		android:paddingTop="10dp"
		android:paddingBottom="10dp"
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@+id/channelFeedToolbar"
		tools:visibility="visible">

		<View
			android:layout_width="3dp"
			android:layout_height="32dp"
			android:layout_marginEnd="10dp"
			android:background="@color/zerion_primary_accent" />

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/channels_pinned_label"
				android:textColor="@color/zerion_primary_accent"
				android:textSize="11sp"
				android:textStyle="bold" />

			<TextView
				android:id="@+id/channelPinnedBannerText"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="1"
				android:textColor="@color/zerion_text_primary"
				android:textSize="14sp"
				tools:text="Today's notes: the new disclosure rules drop on Friday." />

		</LinearLayout>

		<ImageButton
			android:id="@+id/channelPinnedBannerClose"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/channels_action_unpin"
			android:padding="10dp"
			android:src="@drawable/ic_close"
			android:visibility="gone"
			app:tint="@color/zerion_text_secondary"
			tools:visibility="visible" />

	</LinearLayout>

	<TextView
		android:id="@+id/channelApprovalBanner"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/zerion_primary_accent"
		android:gravity="center_vertical"
		android:paddingStart="16dp"
		android:paddingEnd="16dp"
		android:paddingTop="10dp"
		android:paddingBottom="10dp"
		android:textColor="@android:color/white"
		android:textSize="13sp"
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@+id/channelPinnedBanner"
		tools:text="@string/channels_approval_pending_banner"
		tools:visibility="visible" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/channelFeedRecycler"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:clipToPadding="false"
		android:paddingTop="6dp"
		android:paddingBottom="12dp"
		android:scrollbars="none"
		app:layout_constraintBottom_toTopOf="@+id/channelComposeBar"
		app:layout_constraintTop_toBottomOf="@+id/channelApprovalBanner" />

	<TextView
		android:id="@+id/channelFeedEmptyView"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:paddingStart="32dp"
		android:paddingEnd="32dp"
		android:paddingTop="64dp"
		android:textColor="@color/zerion_text_secondary"
		android:textSize="16sp"
		android:visibility="gone"
		app:layout_constraintTop_toBottomOf="@+id/channelFeedToolbar"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		tools:text="@string/channels_feed_empty_subscriber"
		tools:visibility="visible" />

	<LinearLayout
		android:id="@+id/channelComposeBar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:paddingStart="8dp"
		android:paddingEnd="12dp"
		android:paddingTop="10dp"
		android:paddingBottom="14dp"
		android:gravity="center_vertical"
		android:background="@color/window_background"
		android:visibility="gone"
		app:layout_constraintBottom_toBottomOf="parent"
		tools:visibility="visible">

		<ImageButton
			android:id="@+id/channelComposeTtlButton"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/channels_ttl_picker_cd"
			android:padding="10dp"
			android:src="@drawable/ic_timer"
			app:tint="@color/zerion_text_secondary" />

		<ImageButton
			android:id="@+id/channelComposeAttachButton"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/channels_attach_cd"
			android:padding="10dp"
			android:src="@drawable/ic_attach"
			app:tint="@color/zerion_text_secondary" />

		<EditText
			android:id="@+id/channelComposeInput"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:background="@drawable/bg_input_bar"
			android:hint="@string/channels_compose_hint"
			android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
			android:maxLength="4096"
			android:maxLines="4"
			android:minHeight="44dp"
			android:paddingStart="14dp"
			android:paddingEnd="14dp"
			android:paddingTop="10dp"
			android:paddingBottom="10dp"
			android:textColor="@color/zerion_text_primary"
			android:textColorHint="@color/zerion_text_secondary"
			android:textSize="15sp"
			android:importantForAutofill="no" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/channelComposeSendButton"
			style="@style/Widget.MaterialComponents.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:minWidth="0dp"
			android:text="@string/channels_compose_send"
			android:textColor="@color/zerion_primary_accent" />

		<ProgressBar
			android:id="@+id/channelComposeProgress"
			style="?android:attr/progressBarStyleSmall"
			android:layout_width="24dp"
			android:layout_height="24dp"
			android:layout_marginStart="4dp"
			android:indeterminate="true"
			android:visibility="gone"
			tools:visibility="gone" />

	</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
