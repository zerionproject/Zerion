<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/bg_donation_dialog"
	android:fillViewport="false">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingTop="24dp"
		android:paddingBottom="16dp"
		android:paddingHorizontal="20dp">

		<!-- Heart icon -->
		<ImageView
			android:id="@+id/donationIcon"
			android:layout_width="64dp"
			android:layout_height="64dp"
			android:layout_gravity="center_horizontal"
			android:src="@drawable/ic_donation_heart"
			android:importantForAccessibility="no" />

		<!-- Title -->
		<TextView
			android:id="@+id/donationTitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="14dp"
			android:gravity="center"
			android:text="@string/donation_title"
			android:textColor="@android:color/white"
			android:textSize="22sp"
			android:textStyle="bold"
			android:letterSpacing="0.005" />

		<!-- Subtitle -->
		<TextView
			android:id="@+id/donationSubtitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:gravity="center"
			android:lineSpacingExtra="2dp"
			android:text="@string/donation_subtitle"
			android:textColor="@color/zerion_text_secondary"
			android:textSize="14sp" />

		<!-- QR code -->
		<ImageView
			android:id="@+id/donationQr"
			android:layout_width="200dp"
			android:layout_height="200dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="20dp"
			android:background="@android:color/white"
			android:padding="6dp"
			android:contentDescription="@string/donation_url_label"
			tools:src="@tools:sample/avatars" />

		<!-- URL label -->
		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="14dp"
			android:text="@string/donation_url_label"
			android:textColor="@color/zerion_text_secondary"
			android:textSize="11sp"
			android:textAllCaps="true"
			android:letterSpacing="0.05" />

		<!-- URL pill (selectable, monospace) -->
		<TextView
			android:id="@+id/donationUrl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:background="@drawable/bg_donation_url"
			android:paddingHorizontal="14dp"
			android:paddingVertical="12dp"
			android:fontFamily="@font/plex_mono_regular"
			android:textColor="@color/zerion_primary_accent"
			android:textIsSelectable="true"
			android:textSize="13sp"
			tools:text="https://zerion.chat/donate.html" />

		<!-- Copy link — primary action -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/buttonCopyLink"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:layout_marginTop="16dp"
			android:backgroundTint="@color/zerion_primary_accent"
			android:text="@string/donation_button_copy"
			android:textAllCaps="false"
			android:textColor="@android:color/white"
			android:textSize="15sp"
			android:textStyle="bold"
			app:cornerRadius="12dp"
			app:icon="@drawable/ic_content_copy"
			app:iconGravity="textStart"
			app:iconPadding="10dp"
			app:iconTint="@android:color/white"
			app:iconSize="18dp" />

		<!-- Open in browser — guarded text button -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/buttonOpenInBrowser"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="44dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="6dp"
			android:text="@string/donation_button_open_in_browser"
			android:textAllCaps="false"
			android:textColor="@color/zerion_text_secondary"
			android:textSize="13sp" />

		<!-- Maybe later -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/buttonLater"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="44dp"
			android:layout_gravity="center_horizontal"
			android:text="@string/donation_button_later"
			android:textAllCaps="false"
			android:textColor="@color/zerion_text_secondary"
			android:textSize="13sp" />

	</LinearLayout>

</androidx.core.widget.NestedScrollView>
