<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/messageNotSentActions"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:visibility="gone"
	tools:visibility="visible">

	<com.google.android.material.button.MaterialButton
		android:id="@+id/messageEditButton"
		style="@style/Widget.MaterialComponents.Button.TextButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="4dp"
		android:minWidth="48dp"
		android:minHeight="48dp"
		android:text="@string/action_edit_message"
		android:textColor="?attr/zerionColorAccentText"
		android:textAppearance="@style/TextAppearance.Zerion.Label" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/messageDeleteButton"
		style="@style/Widget.MaterialComponents.Button.TextButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="4dp"
		android:minWidth="48dp"
		android:minHeight="48dp"
		android:text="@string/delete"
		android:textColor="?attr/zerionColorOnSurfaceMuted"
		android:textAppearance="@style/TextAppearance.Zerion.Label" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/messageRetryButton"
		style="@style/Widget.MaterialComponents.Button.OutlinedButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:minWidth="48dp"
		android:minHeight="48dp"
		android:text="@string/message_state_retry"
		android:textColor="?attr/zerionColorDangerText"
		app:cornerRadius="24dp"
		app:icon="@drawable/ic_message_state_retry"
		app:iconPadding="6dp"
		app:iconSize="18dp"
		app:iconTint="?attr/zerionColorDangerText"
		app:strokeColor="?attr/zerionColorDangerText"
		app:strokeWidth="1dp"
		android:textAppearance="@style/TextAppearance.Zerion.Label" />

</LinearLayout>
