<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:minHeight="48dp"
	android:layout_marginTop="2dp"
	android:layout_marginBottom="2dp"
	android:gravity="end"
	android:orientation="vertical">

	<androidx.constraintlayout.widget.ConstraintLayout
		android:id="@+id/bubble"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="48dp"
		android:background="@drawable/msg_out"
		android:elevation="@dimen/message_bubble_elevation"
		android:paddingHorizontal="12dp"
		android:paddingVertical="8dp">

		<LinearLayout
			android:id="@+id/quoteBlock"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="4dp"
			android:background="@drawable/bg_reply_quote_out"
			android:clickable="true"
			android:focusable="true"
			android:foreground="?android:attr/selectableItemBackground"
			android:minWidth="@dimen/reply_quote_min_width"
			android:minHeight="48dp"
			android:orientation="horizontal"
			android:visibility="gone"
			app:layout_constrainedWidth="true"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			tools:visibility="visible">

			<View
				android:layout_width="3dp"
				android:layout_height="match_parent"
				android:background="?attr/zerionColorOnBubbleOut" />

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:orientation="vertical"
				android:paddingStart="8dp"
				android:paddingTop="4dp"
				android:paddingEnd="8dp"
				android:paddingBottom="6dp">

				<TextView
					android:id="@+id/quoteAuthor"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxLines="1"
					android:textColor="?attr/zerionColorOnBubbleOut"
					tools:text="Bob"
					android:textAppearance="@style/TextAppearance.Zerion.Label" />

				<TextView
					android:id="@+id/quoteText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:ellipsize="end"
					android:maxWidth="244dp"
					android:maxLines="1"
					android:textColor="?attr/zerionColorOnBubbleOutMuted"
					tools:text="Quoted post"
					android:textAppearance="@style/TextAppearance.Zerion.Caption" />

			</LinearLayout>

		</LinearLayout>

		<TextView
			android:id="@+id/postText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:maxWidth="260dp"
			android:textColor="?attr/zerionColorOnBubbleOut"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/quoteBlock"
			tools:text="Reply"
			android:textColorLink="?attr/zerionColorOnBubbleOut"
			android:textAppearance="@style/TextAppearance.Zerion.Body" />

		<TextView
			android:id="@+id/postTime"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:gravity="center_vertical"
			android:textColor="?attr/zerionColorOnBubbleOutMuted"
			app:layout_constrainedWidth="true"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintHorizontal_bias="1.0"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@+id/postText"
			tools:text="13:37"
			android:textAppearance="@style/TextAppearance.Zerion.Meta" />

	</androidx.constraintlayout.widget.ConstraintLayout>

	<include
		layout="@layout/view_message_not_sent_actions"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp" />

</LinearLayout>
