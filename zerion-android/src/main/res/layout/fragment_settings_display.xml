<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="16dp"
		android:paddingBottom="32dp">

		<!-- ====== APPEARANCE ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/settings_section_appearance" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/language_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_settings"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_language_title" />

					<TextView
						android:id="@+id/language_value"
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/settings_theme_system_default" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/theme_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_settings_brightness"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_theme_title" />

					<TextView
						android:id="@+id/theme_value"
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/settings_theme_dark" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/app_icon_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_app_icon"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_app_icon_title" />

					<TextView
						android:id="@+id/app_icon_value"
						style="@style/Zerion.Settings.Row.Summary"
						tools:text="Default" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/nav_size_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_nav_size"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_nav_size_title" />

					<TextView
						android:id="@+id/nav_size_value"
						style="@style/Zerion.Settings.Row.Summary"
						tools:text="Compact" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

		</LinearLayout>

		<!-- ====== CHAT ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/pref_chat_section" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/text_size_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_text_size"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_text_size_title" />

					<TextView
						android:id="@+id/text_size_value"
						style="@style/Zerion.Settings.Row.Summary"
						tools:text="Medium" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/bubble_color_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<View
					android:id="@+id/bubble_color_preview"
					android:layout_width="22dp"
					android:layout_height="22dp"
					android:layout_marginEnd="16dp"
					android:background="@drawable/color_preview_circle" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_bubble_color_title" />

					<TextView
						android:id="@+id/bubble_color_value"
						style="@style/Zerion.Settings.Row.Summary"
						tools:text="Blue" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/accent_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<View
					android:id="@+id/accent_preview"
					android:layout_width="22dp"
					android:layout_height="22dp"
					android:layout_marginEnd="16dp"
					android:background="@drawable/color_preview_circle" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_accent_title" />

					<TextView
						android:id="@+id/accent_value"
						style="@style/Zerion.Settings.Row.Summary"
						tools:text="Cyan" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

		</LinearLayout>

	</LinearLayout>

</ScrollView>
