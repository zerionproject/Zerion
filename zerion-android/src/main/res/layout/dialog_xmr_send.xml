<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="@drawable/bg_settings_group">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/wallet_xmr_send_available_label"
                android:textColor="@color/zerion_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/xmr_send_available"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/zerion_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/xmr_til_address"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/wallet_xmr_send_to"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_camera_24dp"
            app:endIconContentDescription="@string/wallet_scan">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/xmr_send_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:maxLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/xmr_send_paste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:padding="6dp"
            android:text="@string/wallet_xmr_send_paste"
            android:textAllCaps="true"
            android:textColor="@color/zerion_primary_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/xmr_til_amount"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/wallet_xmr_send_amount"
            app:suffixText="XMR">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/xmr_send_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/xmr_send_equiv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/zerion_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/xmr_send_unit_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/wallet_xmr_send_switch_currency"
                android:textAllCaps="true"
                android:textColor="@color/zerion_primary_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/xmr_pct_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/xmr_pct_10"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/wallet_xmr_send_pct_10"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/xmr_pct_25"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/wallet_xmr_send_pct_25"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/xmr_pct_50"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/wallet_xmr_send_pct_50"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/wallet_xmr_send_priority"
            android:textColor="@color/zerion_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/xmr_priority_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/xmr_prio_low"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/wallet_xmr_send_priority_low" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/xmr_prio_normal"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/wallet_xmr_send_priority_normal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/xmr_prio_high"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/wallet_xmr_send_priority_high" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallet_xmr_send_priority_note"
            android:textColor="@color/zerion_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
