<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="16dp"
		android:paddingBottom="32dp">

		<!-- ====== APP SECURITY ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/settings_section_app_security" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<!-- App Lock -->
			<LinearLayout style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_lock"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_lock_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/pref_lock_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/lock_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" />

			</LinearLayout>

			<!-- Screenshot Protection -->
			<LinearLayout style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_settings_security"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_screenshot_protection_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/pref_screenshot_protection_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/screenshot_protection_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true" />

			</LinearLayout>

			<!-- Lock Timeout -->
			<LinearLayout
				android:id="@+id/lock_timeout_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_lock_open_white"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_lock_timeout_title" />

					<TextView
						android:id="@+id/lock_timeout_value"
						style="@style/Zerion.Settings.Row.Summary"
						tools:text="1 minute" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

			<!-- Change Password -->
			<LinearLayout
				android:id="@+id/change_password_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_key"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/change_password" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/change_password_summary" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

		</LinearLayout>

		<!-- ====== PRIVACY ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/settings_section_privacy" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_edit"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_typing_indicators_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/pref_typing_indicators_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/typing_indicators_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true" />

			</LinearLayout>

		</LinearLayout>

		<!-- ====== CALLS ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/pref_calls_section_title" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_phone"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_voice_calls_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/pref_voice_calls_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/voice_calls_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" />

			</LinearLayout>

			<LinearLayout style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_videocam"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/pref_video_calls_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/pref_video_calls_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/video_calls_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" />

			</LinearLayout>

		</LinearLayout>

		<TextView
			style="@style/Zerion.Settings.SectionFooter"
			android:text="@string/pref_calls_footer" />

		<!-- ====== EMERGENCY WIPE ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/settings_section_emergency_wipe" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/registration_lock_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_lock"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/reg_lock_title" />

					<TextView
						android:id="@+id/reg_lock_summary"
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/reg_lock_summary_off" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:layout_marginTop="14dp"
			android:background="@drawable/bg_settings_group">

			<LinearLayout
				style="@style/Zerion.Settings.Row">

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/decoy_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/decoy_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/decoy_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/decoy_set_code_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/decoy_set_code_title" />

					<TextView
						android:id="@+id/decoy_set_code_summary"
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/decoy_set_code_summary_unset" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

		</LinearLayout>

		<!-- Wipe password is destructive — its own danger group -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:layout_marginTop="14dp"
			android:background="@drawable/bg_settings_group_danger">

			<LinearLayout
				android:id="@+id/wipe_password_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					android:layout_width="22dp"
					android:layout_height="22dp"
					android:layout_marginEnd="16dp"
					android:src="@drawable/ic_warning"
					app:tint="@color/zerion_destructive"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/wipe_password_title"
						android:textSize="15sp"
						android:textStyle="bold"
						android:textColor="@color/zerion_destructive" />

					<TextView
						android:id="@+id/wipe_password_summary"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="@string/wipe_password_summary_disabled"
						android:textSize="12sp"
						android:textColor="#CCEF4444" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_destructive"
					android:importantForAccessibility="no" />

			</LinearLayout>

		</LinearLayout>

	</LinearLayout>

</ScrollView>
