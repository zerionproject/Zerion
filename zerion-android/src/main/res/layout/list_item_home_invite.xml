<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/homeInvite"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingStart="16dp"
	android:paddingTop="12dp"
	android:paddingEnd="16dp"
	android:paddingBottom="12dp">

	<TextView
		android:id="@+id/homeInviteTitle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textAppearance="@style/TextAppearance.Zerion.Body"
		android:textColor="?attr/zerionColorOnSurface"
		tools:text="Book club, invited by Sam" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:orientation="horizontal">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/homeInviteDecline"
			style="@style/Widget.Material3.Button.OutlinedButton"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:layout_marginEnd="8dp"
			android:layout_weight="1"
			android:insetTop="4dp"
			android:insetBottom="4dp"
			android:text="@string/grouptr_pending_decline"
			android:textAppearance="@style/TextAppearance.Zerion.Label"
			android:textColor="?attr/zerionColorOnSurfaceMuted"
			app:cornerRadius="20dp"
			app:strokeColor="?attr/zerionColorOnSurfaceMuted"
			app:strokeWidth="1dp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/homeInviteAccept"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:layout_weight="1"
			android:insetTop="4dp"
			android:insetBottom="4dp"
			android:text="@string/grouptr_pending_accept"
			android:textAppearance="@style/TextAppearance.Zerion.Label"
			android:textColor="@color/zerion_button_filled_foreground"
			app:backgroundTint="@color/zerion_button_filled_background"
			app:cornerRadius="20dp" />

	</LinearLayout>

</LinearLayout>
