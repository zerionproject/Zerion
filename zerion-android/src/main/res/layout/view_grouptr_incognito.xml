<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/incognitoBlock"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<com.google.android.material.materialswitch.MaterialSwitch
		android:id="@+id/incognitoSwitch"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="48dp"
		android:text="@string/grouptr_incognito"
		android:textColor="?attr/zerionColorOnSurface"
		android:textAppearance="@style/TextAppearance.Zerion.Body" />

	<TextView
		android:id="@+id/incognitoSummary"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/grouptr_incognito_explained"
		android:textColor="?attr/zerionColorOnSurfaceMuted"
		android:textAppearance="@style/TextAppearance.Zerion.Caption" />

	<LinearLayout
		android:id="@+id/incognitoNameRow"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:visibility="gone">

		<TextView
			android:id="@+id/incognitoName"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textColor="?attr/zerionColorOnSurface"
			android:textAppearance="@style/TextAppearance.Zerion.Body" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/incognitoNewName"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:text="@string/grouptr_incognito_new_name"
			android:textColor="?attr/zerionColorAccentText"
			android:textAppearance="@style/TextAppearance.Zerion.Label" />

	</LinearLayout>

</LinearLayout>
