<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_zerion_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tabStandard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sticker_tab_standard"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/zerion_text_primary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabMine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/sticker_tab_mine"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/zerion_text_primary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/importStickerButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_input_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sticker_import"
            android:visibility="gone"
            app:tint="@color/zerion_text_primary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stickerList"
        android:layout_width="match_parent"
        android:layout_height="320dp" />
</LinearLayout>
