<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="16dp"
		android:paddingBottom="32dp">

		<!-- ====== SECURITY ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/vault_settings_section_security" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/change_password_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_key"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/vault_settings_change_master" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/vault_settings_change_master_summary" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/autolock_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_lock_open_white"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/vault_settings_autolock" />

					<TextView
						android:id="@+id/autolock_value"
						style="@style/Zerion.Settings.Row.Summary"
						tools:text="60 seconds" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/biometric_card"
				style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_fingerprint"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/vault_settings_biometric" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/vault_settings_biometric_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/biometric_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" />

			</LinearLayout>

		</LinearLayout>

		<!-- ====== PRIVACY ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/vault_settings_section_privacy" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/clipboard_card"
				style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_content_copy"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/vault_settings_clear_clipboard" />

					<TextView
						android:id="@+id/clipboard_timeout_value"
						style="@style/Zerion.Settings.Row.Summary"
						tools:text="30 seconds" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/clipboard_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true" />

			</LinearLayout>

			<LinearLayout style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_visibility_off"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/vault_settings_hide_content" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/vault_settings_hide_content_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/hide_content_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true" />

			</LinearLayout>

		</LinearLayout>

		<!-- ====== DATA ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/vault_settings_section_data" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/export_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_cloud_upload"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/vault_settings_export" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/vault_settings_export_summary" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

		</LinearLayout>

		<!-- Wipe vault — destructive group -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:layout_marginTop="14dp"
			android:background="@drawable/bg_settings_group_danger">

			<LinearLayout
				android:id="@+id/wipe_vault_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					android:layout_width="22dp"
					android:layout_height="22dp"
					android:layout_marginEnd="16dp"
					android:src="@drawable/ic_delete"
					app:tint="@color/zerion_destructive"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="@string/vault_settings_wipe"
						android:textSize="15sp"
						android:textStyle="bold"
						android:textColor="@color/zerion_destructive" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="2dp"
						android:text="@string/vault_settings_wipe_summary"
						android:textSize="12sp"
						android:textColor="#CCEF4444" />

				</LinearLayout>

			</LinearLayout>

		</LinearLayout>

		<!-- Vault info -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/vault_settings_info_title" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:background="@drawable/bg_settings_info_card"
			android:paddingHorizontal="16dp"
			android:paddingVertical="14dp">

			<TextView
				android:id="@+id/encryption_info"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/vault_settings_info_encryption"
				android:textSize="12sp"
				android:fontFamily="@font/plex_mono_regular"
				android:textColor="@color/zerion_text_secondary" />

			<TextView
				android:id="@+id/keystore_info"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="@string/vault_settings_info_keystore"
				android:textSize="12sp"
				android:fontFamily="@font/plex_mono_regular"
				android:textColor="@color/zerion_text_secondary" />

			<TextView
				android:id="@+id/items_count_info"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:textSize="12sp"
				android:fontFamily="@font/plex_mono_regular"
				android:textColor="@color/zerion_text_secondary"
				tools:text="Total Items: 0" />

		</LinearLayout>

		<com.google.android.material.button.MaterialButton
			android:id="@+id/back_to_vault_button"
			android:layout_width="match_parent"
			android:layout_height="56dp"
			android:layout_marginTop="24dp"
			android:text="@string/vault_settings_back"
			android:textSize="16sp"
			style="@style/Zerion.Button.Primary"
			app:icon="@drawable/ic_back"
			app:iconGravity="start"
			app:cornerRadius="14dp" />

	</LinearLayout>

</ScrollView>
