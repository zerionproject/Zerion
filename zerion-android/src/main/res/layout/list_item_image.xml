<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="@dimen/message_bubble_image_default"
	android:layout_height="@dimen/message_bubble_image_default"
	android:duplicateParentState="true">

	<ImageView
		android:id="@+id/imageView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:duplicateParentState="true"
		android:scaleType="centerCrop"
		tools:ignore="ContentDescription"
		tools:srcCompat="@tools:sample/avatars" />

	<ImageView
		android:id="@+id/playOverlay"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:importantForAccessibility="no"
		android:layout_gravity="center"
		android:background="@drawable/bg_video_play_circle"
		android:padding="12dp"
		android:src="@drawable/ic_play_arrow_24dp"
		android:visibility="gone"
		tools:ignore="ContentDescription"
		app:tint="?attr/zerionColorOnScrim" />

	<TextView
		android:id="@+id/videoSize"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom|start"
		android:layout_marginStart="6dp"
		android:layout_marginBottom="6dp"
		android:background="?attr/zerionColorScrim"
		android:importantForAccessibility="no"
		android:paddingHorizontal="6dp"
		android:paddingVertical="2dp"
		android:textAppearance="@style/TextAppearance.Zerion.Meta"
		android:textColor="?attr/zerionColorOnScrim"
		android:visibility="gone"
		tools:text="3.2 MB" />

</FrameLayout>
