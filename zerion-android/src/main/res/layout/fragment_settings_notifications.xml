<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingHorizontal="16dp"
		android:paddingBottom="32dp">

		<!-- ====== ALERTS ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/settings_section_alerts" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_notifications"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/notify_sign_in_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/notify_sign_in_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/notify_sign_in_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/notify_private_messages_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/message_sent"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/notify_private_messages_setting_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/notify_private_messages_setting_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/notify_private_messages_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/notify_group_messages_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_group"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/notify_group_messages_setting_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/notify_group_messages_setting_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/notify_group_messages_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/notify_channel_posts_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_channels"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/notify_channel_posts_setting_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/notify_channel_posts_setting_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/notify_channel_posts_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/notify_voice_calls_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_phone_white"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/notify_voice_calls_setting_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/notify_voice_calls_setting_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/notify_voice_calls_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true" />

			</LinearLayout>

			<LinearLayout style="@style/Zerion.Settings.Row">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_reply"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/notify_quick_reply_title" />

					<TextView
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/notify_quick_reply_summary" />

				</LinearLayout>

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/notify_quick_reply_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true" />

			</LinearLayout>

		</LinearLayout>

		<!-- ====== SOUNDS & VIBRATION ====== -->
		<TextView
			style="@style/Zerion.Settings.SectionHeader"
			android:text="@string/settings_section_sounds_vibration" />

		<LinearLayout style="@style/Zerion.Settings.Group">

			<LinearLayout
				android:id="@+id/notify_vibration_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_settings"
					android:importantForAccessibility="no" />

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/notify_vibration_setting"
					android:textSize="15sp"
					android:textColor="@color/zerion_text_primary" />

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/notify_vibration_switch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true" />

			</LinearLayout>

			<LinearLayout
				android:id="@+id/notify_sound_card"
				style="@style/Zerion.Settings.Row.Clickable">

				<ImageView
					style="@style/Zerion.Settings.Row.Icon"
					android:src="@drawable/ic_settings"
					android:importantForAccessibility="no" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						style="@style/Zerion.Settings.Row.Title"
						android:text="@string/notify_sound_setting" />

					<TextView
						android:id="@+id/notify_sound_value"
						style="@style/Zerion.Settings.Row.Summary"
						android:text="@string/settings_default_value" />

				</LinearLayout>

				<ImageView
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:src="@drawable/ic_chevron_right"
					app:tint="@color/zerion_text_secondary"
					android:importantForAccessibility="no" />

			</LinearLayout>

		</LinearLayout>

	</LinearLayout>

</ScrollView>
