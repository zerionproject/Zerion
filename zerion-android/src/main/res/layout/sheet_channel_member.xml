<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/channelMemberSheet"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/bg_sheet"
	android:divider="@drawable/divider_channel_settings_row"
	android:orientation="vertical"
	android:paddingTop="8dp"
	android:paddingBottom="20dp"
	android:showDividers="middle">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">

		<View
			android:layout_width="36dp"
			android:layout_height="4dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginBottom="14dp"
			android:background="@drawable/bg_sheet_handle"
			android:importantForAccessibility="no" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="24dp"
			android:paddingEnd="24dp"
			android:paddingBottom="16dp"
			android:screenReaderFocusable="true">

			<TextView
				android:id="@+id/channelMemberAvatar"
				android:layout_width="52dp"
				android:layout_height="52dp"
				android:layout_marginEnd="14dp"
				android:background="@drawable/badge_circle_cyan"
				android:gravity="center"
				android:importantForAccessibility="no"
				android:fontFamily="@font/bricolage_grotesque"
				android:textAppearance="@style/TextAppearance.Zerion.Title"
				android:textColor="?attr/zerionColorOnAccent"
				tools:text="R" />

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:id="@+id/channelMemberName"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:accessibilityHeading="true"
					android:ellipsize="end"
					android:maxLines="2"
					android:fontFamily="@font/bricolage_grotesque"
					android:textAppearance="@style/TextAppearance.Zerion.Headline"
					android:textColor="?attr/zerionColorOnSurface"
					tools:text="Robin" />

				<TextView
					android:id="@+id/channelMemberRole"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:textAppearance="@style/TextAppearance.Zerion.Caption"
					android:textColor="?attr/zerionColorOnSurfaceMuted"
					tools:text="Subscriber · Trusted" />

			</LinearLayout>

		</LinearLayout>

	</LinearLayout>

	<LinearLayout
		android:id="@+id/channelMemberTrust"
		style="@style/GroupTrAdminActionRow"
		android:minHeight="52dp">

		<ImageView
			style="@style/GroupTrAdminActionIcon"
			android:contentDescription="@null"
			android:importantForAccessibility="no"
			android:src="@drawable/ic_check_circle_outline"
			app:tint="?attr/zerionColorAccentIcon" />

		<TextView
			android:id="@+id/channelMemberTrustText"
			style="@style/GroupTrAdminActionText"
			android:text="@string/channels_member_trust" />

	</LinearLayout>

	<LinearLayout
		android:id="@+id/channelMemberEditor"
		style="@style/GroupTrAdminActionRow"
		android:minHeight="52dp">

		<ImageView
			style="@style/GroupTrAdminActionIcon"
			android:contentDescription="@null"
			android:importantForAccessibility="no"
			android:src="@drawable/ic_edit"
			app:tint="?attr/zerionColorAccentIcon" />

		<TextView
			android:id="@+id/channelMemberEditorText"
			style="@style/GroupTrAdminActionText"
			android:text="@string/channels_member_make_editor" />

	</LinearLayout>

	<LinearLayout
		android:id="@+id/channelMemberRemove"
		style="@style/GroupTrAdminActionRow"
		android:minHeight="52dp">

		<ImageView
			style="@style/GroupTrAdminActionIcon"
			android:contentDescription="@null"
			android:importantForAccessibility="no"
			android:src="@drawable/ic_person_remove"
			app:tint="?attr/zerionColorDangerText" />

		<TextView
			style="@style/GroupTrAdminActionTextDanger"
			android:text="@string/channels_member_remove" />

	</LinearLayout>

	<LinearLayout
		android:id="@+id/channelMemberBlock"
		style="@style/GroupTrAdminActionRow"
		android:minHeight="52dp">

		<ImageView
			style="@style/GroupTrAdminActionIcon"
			android:contentDescription="@null"
			android:importantForAccessibility="no"
			android:src="@drawable/ic_block"
			app:tint="?attr/zerionColorDangerText" />

		<TextView
			style="@style/GroupTrAdminActionTextDanger"
			android:text="@string/channels_member_block" />

	</LinearLayout>

	<LinearLayout
		android:id="@+id/channelMemberUnblock"
		style="@style/GroupTrAdminActionRow"
		android:minHeight="52dp">

		<ImageView
			style="@style/GroupTrAdminActionIcon"
			android:contentDescription="@null"
			android:importantForAccessibility="no"
			android:src="@drawable/ic_block"
			app:tint="?attr/zerionColorAccentIcon" />

		<TextView
			style="@style/GroupTrAdminActionText"
			android:text="@string/channels_member_unblock" />

	</LinearLayout>

	<LinearLayout
		android:id="@+id/channelMemberSafetyCode"
		style="@style/GroupTrAdminActionRow"
		android:minHeight="52dp">

		<ImageView
			style="@style/GroupTrAdminActionIcon"
			android:contentDescription="@null"
			android:importantForAccessibility="no"
			android:src="@drawable/ic_security"
			app:tint="?attr/zerionColorOnSurfaceMuted" />

		<com.professor.zerion.android.view.WrapRow
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				style="@style/GroupTrAdminActionText"
				android:layout_marginEnd="12dp"
				android:text="@string/channels_member_safety_code"
				android:textColor="?attr/zerionColorOnSurfaceMuted" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:maxLines="1"
				android:text="@string/channels_settings_advanced"
				android:textAppearance="@style/TextAppearance.Zerion.Caption"
				android:textColor="?attr/zerionColorOnSurfaceMuted" />

		</com.professor.zerion.android.view.WrapRow>

	</LinearLayout>

</LinearLayout>
