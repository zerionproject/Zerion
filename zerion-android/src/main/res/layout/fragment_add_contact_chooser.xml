<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_zerion_gradient"
	android:orientation="vertical"
	android:paddingHorizontal="20dp"
	android:paddingTop="32dp"
	android:paddingBottom="24dp">

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:text="@string/add_contact_method_subtitle"
		android:textColor="#CCFFFFFF"
		android:textSize="16sp"
		android:letterSpacing="0.01" />

	<!-- QR Code Exchange (recommended) -->
	<androidx.cardview.widget.CardView
		android:id="@+id/qrExchangeCard"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="28dp"
		android:foreground="?attr/selectableItemBackground"
		android:clickable="true"
		android:focusable="true"
		app:cardBackgroundColor="@color/zerion_surface_elevated"
		app:cardCornerRadius="20dp"
		app:cardElevation="0dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="20dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical">

				<FrameLayout
					android:layout_width="48dp"
					android:layout_height="48dp"
					android:background="@drawable/bg_add_contact_icon_accent">

					<ImageView
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:layout_gravity="center"
						android:src="@drawable/ic_camera_24dp"
						app:tint="@color/zerion_primary_accent"
						android:contentDescription="@null" />

				</FrameLayout>

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginStart="14dp"
					android:text="@string/qr_exchange_card_title"
					android:textColor="@color/zerion_text_primary"
					android:textSize="18sp"
					android:textStyle="bold" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_recommended_badge"
					android:paddingHorizontal="10dp"
					android:paddingVertical="3dp"
					android:text="@string/recommended"
					android:textColor="@android:color/white"
					android:textSize="11sp"
					android:textStyle="bold" />

			</LinearLayout>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:text="@string/qr_exchange_card_description"
				android:textColor="@color/zerion_text_secondary"
				android:textSize="14sp"
				android:lineSpacingExtra="2dp" />

		</LinearLayout>

	</androidx.cardview.widget.CardView>

	<!-- Link Exchange -->
	<androidx.cardview.widget.CardView
		android:id="@+id/linkExchangeCard"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="14dp"
		android:foreground="?attr/selectableItemBackground"
		android:clickable="true"
		android:focusable="true"
		app:cardBackgroundColor="@color/zerion_surface_elevated"
		app:cardCornerRadius="20dp"
		app:cardElevation="0dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="20dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical">

				<FrameLayout
					android:layout_width="48dp"
					android:layout_height="48dp"
					android:background="@drawable/bg_add_contact_icon_neutral">

					<ImageView
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:layout_gravity="center"
						android:src="@drawable/ic_link"
						app:tint="@color/zerion_text_primary"
						android:contentDescription="@null" />

				</FrameLayout>

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginStart="14dp"
					android:text="@string/link_exchange_card_title"
					android:textColor="@color/zerion_text_primary"
					android:textSize="18sp"
					android:textStyle="bold" />

			</LinearLayout>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:text="@string/link_exchange_card_description"
				android:textColor="@color/zerion_text_secondary"
				android:textSize="14sp"
				android:lineSpacingExtra="2dp" />

		</LinearLayout>

	</androidx.cardview.widget.CardView>

	<androidx.cardview.widget.CardView
		android:id="@+id/nearbyPairCard"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="14dp"
		android:foreground="?attr/selectableItemBackground"
		android:clickable="true"
		android:focusable="true"
		app:cardBackgroundColor="@color/zerion_surface_elevated"
		app:cardCornerRadius="20dp"
		app:cardElevation="0dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="20dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical">

				<FrameLayout
					android:layout_width="48dp"
					android:layout_height="48dp"
					android:background="@drawable/bg_add_contact_icon_neutral">

					<ImageView
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:layout_gravity="center"
						android:src="@drawable/ic_camera_24dp"
						app:tint="@color/zerion_text_primary"
						android:contentDescription="@null" />

				</FrameLayout>

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginStart="14dp"
					android:text="@string/nearby_pair_card_title"
					android:textColor="@color/zerion_text_primary"
					android:textSize="18sp"
					android:textStyle="bold" />

			</LinearLayout>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:text="@string/nearby_pair_card_description"
				android:textColor="@color/zerion_text_secondary"
				android:textSize="14sp"
				android:lineSpacingExtra="2dp" />

		</LinearLayout>

	</androidx.cardview.widget.CardView>

</LinearLayout>
