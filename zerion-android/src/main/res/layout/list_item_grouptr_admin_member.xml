<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:minHeight="56dp"
	android:orientation="horizontal"
	android:paddingHorizontal="20dp"
	android:paddingVertical="10dp">

	<TextView
		android:id="@+id/memberAvatar"
		android:layout_width="36dp"
		android:layout_height="36dp"
		android:background="@drawable/badge_circle_cyan"
		android:gravity="center"
		android:textColor="?attr/zerionColorOnAccent"
		android:textSize="15sp"
		android:textStyle="bold"
		tools:text="A" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginStart="14dp"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/memberName"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1"
			android:textColor="?attr/zerionColorOnSurface"
			tools:text="Alice"
			android:textAppearance="@style/TextAppearance.Zerion.Body" />

		<TextView
			android:id="@+id/memberRole"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:textColor="?attr/zerionColorOnSurfaceMuted"
			android:visibility="gone"
			tools:text="creator"
			tools:visibility="visible"
			android:textAppearance="@style/TextAppearance.Zerion.Meta" />

		<com.google.android.material.materialswitch.MaterialSwitch
			android:id="@+id/memberMayAddSwitch"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:text="@string/grouptr_member_may_add"
			android:textColor="?attr/zerionColorOnSurfaceMuted"
			android:visibility="gone"
			tools:visibility="visible"
			android:textAppearance="@style/TextAppearance.Zerion.Caption" />

	</LinearLayout>

	<com.google.android.material.button.MaterialButton
		android:id="@+id/memberMenuButton"
		style="@style/Widget.Material3.Button.IconButton"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:contentDescription="@string/selection_more_description"
		android:insetTop="0dp"
		android:insetBottom="0dp"
		android:visibility="gone"
		app:icon="@drawable/ic_more_vert"
		app:iconSize="20dp"
		app:iconTint="?attr/zerionColorOnSurfaceMuted"
		tools:visibility="visible" />

</LinearLayout>
