<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginTop="2dp"
	android:layout_marginBottom="2dp"
	android:orientation="vertical">

	<TextView
		android:id="@+id/senderName"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="14dp"
		android:layout_marginBottom="-6dp"
		android:paddingTop="8dp"
		android:paddingBottom="8dp"
		android:textColor="?attr/zerionColorAccentText"
		tools:text="Alice"
		android:textAppearance="@style/TextAppearance.Zerion.Label" />

	<androidx.constraintlayout.widget.ConstraintLayout
		android:id="@+id/mediaBubble"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="48dp"
		android:background="@drawable/msg_in"
		android:elevation="@dimen/message_bubble_elevation"
		android:padding="3dp">

		<ImageView
			android:id="@+id/videoThumb"
			app:tint="@color/selected_media"
			app:tintMode="src_atop"
			android:layout_width="240dp"
			android:layout_height="180dp"
			android:adjustViewBounds="true"
			android:background="?attr/zerionColorScrim"
			android:contentDescription="@string/grouptr_video"
			android:scaleType="centerCrop"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent" />

		<View
			android:id="@+id/playCircleBg"
			android:layout_width="56dp"
			android:layout_height="56dp"
			android:importantForAccessibility="no"
			android:background="@drawable/bg_video_play_circle"
			app:layout_constraintBottom_toBottomOf="@+id/videoThumb"
			app:layout_constraintEnd_toEndOf="@+id/videoThumb"
			app:layout_constraintStart_toStartOf="@+id/videoThumb"
			app:layout_constraintTop_toTopOf="@+id/videoThumb" />

		<androidx.appcompat.widget.AppCompatImageView
			android:id="@+id/videoPlayIcon"
			android:layout_width="32dp"
			android:layout_height="32dp"
			android:importantForAccessibility="no"
			android:scaleType="center"
			app:layout_constraintBottom_toBottomOf="@+id/playCircleBg"
			app:layout_constraintEnd_toEndOf="@+id/playCircleBg"
			app:layout_constraintStart_toStartOf="@+id/playCircleBg"
			app:layout_constraintTop_toTopOf="@+id/playCircleBg"
			app:srcCompat="@drawable/ic_play_arrow_24dp"
			app:tint="?attr/zerionColorOnScrim" />

		<TextView
			android:id="@+id/videoDuration"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="6dp"
			android:layout_marginTop="6dp"
			android:background="?attr/zerionColorScrim"
			android:paddingHorizontal="6dp"
			android:paddingVertical="2dp"
			android:textColor="?attr/zerionColorOnScrim"
			app:layout_constraintStart_toStartOf="@+id/videoThumb"
			app:layout_constraintTop_toTopOf="@+id/videoThumb"
			tools:text="0:08"
			android:textAppearance="@style/TextAppearance.Zerion.Meta" />

		<TextView
			android:id="@+id/videoTime"
			style="@style/TextMessage.Timestamp.Scrim"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginEnd="6dp"
			android:layout_marginBottom="4dp"
			android:background="?attr/zerionColorScrim"
			android:paddingHorizontal="6dp"
			android:paddingVertical="2dp"
			app:layout_constraintBottom_toBottomOf="@+id/videoThumb"
			app:layout_constraintEnd_toEndOf="@+id/videoThumb"
			tools:text="13:37" />

	</androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
