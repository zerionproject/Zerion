<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Shadow layer -->
	<item
		android:left="2dp"
		android:top="2dp">
		<shape android:shape="rectangle">
			<corners android:radius="18dp"/>
			<solid android:color="#4D003366"/>
		</shape>
	</item>

	<!-- Gradient bubble: #009BFF → #005CFF (top-left → bottom-right) -->
	<item
		android:bottom="2dp"
		android:right="2dp">
		<shape android:shape="rectangle">
			<gradient
				android:angle="135"
				android:startColor="#009BFF"
				android:endColor="#005CFF"
				android:type="linear"/>
			<corners android:radius="18dp"/>
		</shape>
	</item>
</layer-list>
