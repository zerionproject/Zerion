<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
	android:shape="rectangle">
	<!-- Rounded corners for Signal/Molly style -->
	<corners android:radius="16dp"/>

	<!-- Padding inside the bubble -->
	<padding
		android:bottom="8dp"
		android:left="12dp"
		android:right="12dp"
		android:top="8dp"/>

	<!-- Dim grey background (system message style) -->
	<solid android:color="@color/zerion_card_bg"/>

	<!-- Subtle border -->
	<stroke
		android:width="1dp"
		android:color="@color/zerion_divider"/>
</shape>
