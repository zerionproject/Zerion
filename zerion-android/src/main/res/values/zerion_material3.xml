<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

	<!-- ================================================================== -->
	<!-- ZERION MATERIAL 3 COMPONENT LIBRARY                                -->
	<!-- Shared button/input/card/toolbar styles applied per-layout on top  -->
	<!-- of the app theme (ZerionTheme).                                    -->
	<!-- ================================================================== -->

	<!-- ================================================================== -->
	<!-- SHAPE TOKENS                                                       -->
	<!-- ================================================================== -->

	<!-- Base shape appearance -->
	<style name="Zerion.Shape" parent="ShapeAppearance.Material3.Corner.Medium">
		<item name="cornerFamily">rounded</item>
	</style>

	<style name="Zerion.Shape.Small" parent="Zerion.Shape">
		<item name="cornerSize">8dp</item>
	</style>

	<style name="Zerion.Shape.Medium" parent="Zerion.Shape">
		<item name="cornerSize">12dp</item>
	</style>

	<style name="Zerion.Shape.Large" parent="Zerion.Shape">
		<item name="cornerSize">16dp</item>
	</style>

	<!-- ================================================================== -->
	<!-- BUTTON COMPONENTS                                                  -->
	<!-- ================================================================== -->

	<!-- Primary: Fully transparent with cyan border (main action buttons) -->
	<style name="Zerion.Button.Primary" parent="Widget.Material3.Button">
		<item name="android:textColor">@android:color/white</item>
		<item name="backgroundTint">@android:color/transparent</item>
		<item name="strokeColor">@color/zerion_cyan</item>
		<item name="strokeWidth">2dp</item>
		<item name="cornerRadius">8dp</item>
		<item name="rippleColor">#1AFFFFFF</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">16sp</item>
		<item name="android:textStyle">bold</item>
		<item name="android:paddingTop">12dp</item>
		<item name="android:paddingBottom">12dp</item>
		<item name="android:minHeight">48dp</item>
		<item name="elevation">0dp</item>
	</style>

	<!-- Filled: Solid cyan background (primary actions) -->
	<style name="Zerion.Button.Filled" parent="Widget.Material3.Button">
		<item name="android:textColor">@android:color/white</item>
		<item name="backgroundTint">@color/zerion_cyan</item>
		<item name="cornerRadius">8dp</item>
		<item name="rippleColor">#FFFFFF</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">16sp</item>
		<item name="android:textStyle">bold</item>
		<item name="android:paddingTop">12dp</item>
		<item name="android:paddingBottom">12dp</item>
		<item name="android:minHeight">48dp</item>
		<item name="elevation">2dp</item>
	</style>

	<!-- Text: Cyan text only (tertiary actions) -->
	<style name="Zerion.Button.Text" parent="Widget.Material3.Button.TextButton">
		<item name="android:textColor">@color/zerion_cyan</item>
		<item name="rippleColor">#1AFFFFFF</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">14sp</item>
		<item name="android:textStyle">bold</item>
	</style>

	<!-- Outlined: White text with cyan border (secondary actions) -->
	<style name="Zerion.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
		<item name="android:textColor">@android:color/white</item>
		<item name="strokeColor">@color/zerion_cyan</item>
		<item name="strokeWidth">2dp</item>
		<item name="cornerRadius">8dp</item>
		<item name="rippleColor">#1AFFFFFF</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">16sp</item>
		<item name="backgroundTint">@android:color/transparent</item>
	</style>

	<!-- Icon Button: For toolbar and FAB menu items -->
	<style name="Zerion.Button.Icon" parent="Widget.Material3.Button.IconButton">
		<item name="iconTint">@color/zerion_cyan</item>
		<item name="rippleColor">#1AFFFFFF</item>
	</style>

	<!-- Negative Button: Red text for destructive actions -->
	<style name="Zerion.Button.Negative" parent="Widget.Material3.Button.TextButton">
		<item name="android:textColor">@color/zerion_red_500</item>
		<item name="rippleColor">#33FF0000</item>
		<item name="android:textAllCaps">false</item>
		<item name="android:textSize">14sp</item>
		<item name="android:textStyle">bold</item>
	</style>

	<!-- ================================================================== -->
	<!-- TEXT INPUT COMPONENTS                                              -->
	<!-- ================================================================== -->

	<!-- Base Text Input: Solid dark background with cyan border -->
	<style name="Zerion.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
		<item name="boxBackgroundColor">@color/zerion_card_bg</item>
		<item name="boxStrokeColor">@color/zerion_cyan</item>
		<item name="boxStrokeWidth">2dp</item>
		<item name="boxCornerRadiusTopStart">12dp</item>
		<item name="boxCornerRadiusTopEnd">12dp</item>
		<item name="boxCornerRadiusBottomStart">12dp</item>
		<item name="boxCornerRadiusBottomEnd">12dp</item>
		<item name="hintTextColor">@color/zerion_cyan</item>
		<item name="android:textColorHint">#80FFFFFF</item>
		<item name="endIconTint">@color/zerion_cyan</item>
		<item name="startIconTint">@color/zerion_cyan</item>
		<item name="errorTextColor">@color/zerion_error_red</item>
		<item name="errorIconTint">@color/zerion_error_red</item>
	</style>

	<!-- Transparent variant (for setup screens with gradient backgrounds) -->
	<style name="Zerion.TextInput.Transparent" parent="Widget.Material3.TextInputLayout.OutlinedBox">
		<item name="boxBackgroundColor">@android:color/transparent</item>
		<item name="boxStrokeColor">@color/zerion_cyan</item>
		<item name="boxStrokeWidth">2dp</item>
		<item name="boxCornerRadiusTopStart">12dp</item>
		<item name="boxCornerRadiusTopEnd">12dp</item>
		<item name="boxCornerRadiusBottomStart">12dp</item>
		<item name="boxCornerRadiusBottomEnd">12dp</item>
		<item name="hintTextColor">@color/zerion_cyan</item>
		<item name="android:textColorHint">#80FFFFFF</item>
		<item name="errorTextColor">@color/zerion_error_red</item>
		<item name="errorIconTint">@color/zerion_error_red</item>
		<item name="endIconTint">@color/zerion_cyan</item>
	</style>

	<!-- Login screen variant - Enhanced readability with semi-transparent background -->
	<style name="Zerion.TextInput.Login" parent="Widget.Material3.TextInputLayout.OutlinedBox">
		<item name="boxBackgroundColor">#B31A1A1A</item>
		<item name="boxStrokeColor">@color/zerion_cyan</item>
		<item name="boxStrokeWidth">1.5dp</item>
		<item name="boxCornerRadiusTopStart">14dp</item>
		<item name="boxCornerRadiusTopEnd">14dp</item>
		<item name="boxCornerRadiusBottomStart">14dp</item>
		<item name="boxCornerRadiusBottomEnd">14dp</item>
		<item name="hintTextColor">@color/zerion_cyan</item>
		<item name="android:textColorHint">#99FFFFFF</item>
		<item name="errorTextColor">@color/zerion_error_red</item>
		<item name="errorIconTint">@color/zerion_error_red</item>
		<item name="endIconTint">@color/zerion_cyan</item>
		<item name="android:elevation">4dp</item>
		<item name="android:paddingStart">12dp</item>
		<item name="android:paddingEnd">12dp</item>
	</style>

	<!-- Outlined variant -->
	<style name="Zerion.TextInput.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
		<item name="boxBackgroundColor">@android:color/transparent</item>
		<item name="boxStrokeColor">@color/zerion_cyan</item>
		<item name="boxStrokeWidth">2dp</item>
		<item name="boxCornerRadiusTopStart">12dp</item>
		<item name="boxCornerRadiusTopEnd">12dp</item>
		<item name="boxCornerRadiusBottomStart">12dp</item>
		<item name="boxCornerRadiusBottomEnd">12dp</item>
		<item name="hintTextColor">@color/zerion_cyan</item>
		<item name="android:textColorHint">#80FFFFFF</item>
		<item name="errorTextColor">@color/zerion_error_red</item>
		<item name="errorIconTint">@color/zerion_error_red</item>
	</style>

	<!-- ================================================================== -->
	<!-- CARD COMPONENTS                                                    -->
	<!-- ================================================================== -->

	<!-- Glass Card: Transparent with cyan border -->
	<style name="Zerion.Card.Glass" parent="Widget.Material3.CardView.Elevated">
		<item name="cardBackgroundColor">#33FFFFFF</item>
		<item name="strokeColor">@color/zerion_cyan</item>
		<item name="strokeWidth">1dp</item>
		<item name="cardCornerRadius">16dp</item>
		<item name="cardElevation">0dp</item>
		<item name="rippleColor">#1AFFFFFF</item>
	</style>

	<!-- Solid Card: Dark background with cyan border -->
	<style name="Zerion.Card.Solid" parent="Widget.Material3.CardView.Filled">
		<item name="cardBackgroundColor">@color/zerion_card_bg</item>
		<item name="strokeColor">@color/zerion_cyan</item>
		<item name="strokeWidth">1dp</item>
		<item name="cardCornerRadius">16dp</item>
		<item name="cardElevation">0dp</item>
	</style>

	<!-- Outlined Card: Transparent with strong cyan border -->
	<style name="Zerion.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
		<item name="cardBackgroundColor">@android:color/transparent</item>
		<item name="strokeColor">@color/zerion_cyan</item>
		<item name="strokeWidth">2dp</item>
		<item name="cardCornerRadius">16dp</item>
		<item name="cardElevation">0dp</item>
	</style>

	<!-- Default Card: Alias for Glass card -->
	<style name="Zerion.Card" parent="Zerion.Card.Glass" />

	<!-- ================================================================== -->
	<!-- FAB & FLOATING ELEMENTS                                            -->
	<!-- ================================================================== -->

	<style name="Zerion.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
		<item name="backgroundTint">@color/zerion_cyan</item>
		<item name="tint">@android:color/white</item>
		<item name="rippleColor">#FFFFFF</item>
		<item name="elevation">6dp</item>
		<item name="pressedTranslationZ">12dp</item>
	</style>

	<style name="Zerion.FAB.Small" parent="Widget.Material3.FloatingActionButton.Small.Primary">
		<item name="backgroundTint">@color/zerion_cyan</item>
		<item name="tint">@android:color/white</item>
		<item name="rippleColor">#FFFFFF</item>
		<item name="elevation">6dp</item>
	</style>

	<!-- ================================================================== -->
	<!-- TOOLBAR & APPBAR                                                   -->
	<!-- ================================================================== -->

	<style name="Zerion.Toolbar" parent="Widget.Material3.Toolbar">
		<item name="android:background">@drawable/bg_toolbar_gradient</item>
		<item name="titleTextColor">@android:color/white</item>
		<item name="subtitleTextColor">#B3FFFFFF</item>
		<item name="navigationIconTint">@color/zerion_cyan</item>
		<item name="android:elevation">4dp</item>
	</style>

	<style name="Zerion.AppBar" parent="Widget.Material3.AppBarLayout">
		<item name="android:background">@drawable/bg_toolbar_gradient</item>
		<item name="elevation">4dp</item>
	</style>

	<!-- ================================================================== -->
	<!-- DIALOG COMPONENTS                                                  -->
	<!-- ================================================================== -->

	<style name="Zerion.Dialog" parent="Theme.Material3.Dark.Dialog">
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:backgroundDimAmount">0.6</item>
		<item name="colorSurface">@color/zerion_card_bg</item>
		<item name="colorOnSurface">@android:color/white</item>
		<item name="buttonBarPositiveButtonStyle">@style/Zerion.Button.Text</item>
		<item name="buttonBarNegativeButtonStyle">@style/Zerion.Button.Text</item>
		<item name="buttonBarNeutralButtonStyle">@style/Zerion.Button.Text</item>
	</style>

	<style name="Zerion.Dialog.FullScreen" parent="Zerion.Dialog">
		<item name="android:windowIsFloating">false</item>
		<item name="android:windowAnimationStyle">@style/FullScreenDialogAnimation</item>
	</style>

	<!-- ================================================================== -->
	<!-- PROGRESS INDICATORS                                                -->
	<!-- ================================================================== -->

	<style name="Zerion.Progress.Circular" parent="Widget.Material3.CircularProgressIndicator">
		<item name="indicatorColor">@color/zerion_cyan</item>
		<item name="trackColor">@color/zerion_card_bg</item>
		<item name="trackThickness">4dp</item>
	</style>

	<style name="Zerion.Progress.Linear" parent="Widget.Material3.LinearProgressIndicator">
		<item name="indicatorColor">@color/zerion_cyan</item>
		<item name="trackColor">@color/zerion_card_bg</item>
		<item name="trackThickness">4dp</item>
		<item name="trackCornerRadius">2dp</item>
	</style>

	<!-- ================================================================== -->
	<!-- NAVIGATION COMPONENTS                                              -->
	<!-- ================================================================== -->

	<style name="Zerion.NavigationView" parent="Widget.Material3.NavigationView">
		<item name="android:background">@drawable/bg_zerion_gradient</item>
		<item name="itemTextColor">@android:color/white</item>
		<item name="itemIconTint">@color/zerion_cyan</item>
		<item name="itemShapeFillColor">#1AFFFFFF</item>
		<item name="itemRippleColor">#1AFFFFFF</item>
	</style>

	<style name="Zerion.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
		<item name="android:background">@color/zerion_card_bg</item>
		<item name="itemTextColor">@android:color/white</item>
		<item name="itemIconTint">@color/zerion_cyan</item>
		<item name="itemRippleColor">#1AFFFFFF</item>
		<item name="labelVisibilityMode">labeled</item>
	</style>

	<style name="Zerion.TabLayout" parent="Widget.Material3.TabLayout">
		<item name="android:background">@color/zerion_card_bg</item>
		<item name="tabTextColor">#B3FFFFFF</item>
		<item name="tabSelectedTextColor">@android:color/white</item>
		<item name="tabIndicatorColor">@color/zerion_cyan</item>
		<item name="tabIndicatorHeight">3dp</item>
		<item name="tabRippleColor">#1AFFFFFF</item>
		<item name="tabTextAppearance">@style/Zerion.TabLayout.TextAppearance</item>
	</style>

	<style name="Zerion.TabLayout.TextAppearance" parent="TextAppearance.Material3.BodyMedium">
		<item name="android:textSize">14sp</item>
		<item name="android:textStyle">bold</item>
		<item name="android:textAllCaps">false</item>
	</style>

	<!-- ================================================================== -->
	<!-- CHIP COMPONENTS                                                    -->
	<!-- ================================================================== -->

	<style name="Zerion.Chip" parent="Widget.Material3.Chip.Assist">
		<item name="chipBackgroundColor">@color/zerion_card_bg</item>
		<item name="chipStrokeColor">@color/zerion_cyan</item>
		<item name="chipStrokeWidth">1dp</item>
		<item name="android:textColor">@android:color/white</item>
		<item name="chipIconTint">@color/zerion_cyan</item>
		<item name="closeIconTint">@color/zerion_cyan</item>
		<item name="rippleColor">#1AFFFFFF</item>
	</style>

	<!-- ================================================================== -->
	<!-- SWITCH & CHECKBOX                                                  -->
	<!-- ================================================================== -->

	<style name="Zerion.Switch" parent="Widget.Material3.CompoundButton.Switch">
		<item name="thumbTint">@android:color/white</item>
		<item name="trackTint">@color/zerion_cyan</item>
		<item name="trackDecorationTint">@color/zerion_card_bg</item>
	</style>

	<style name="Zerion.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
		<item name="buttonTint">@color/zerion_cyan</item>
		<item name="android:textColor">@android:color/white</item>
	</style>

	<!-- Alias for lowercase compatibility -->
	<style name="Zerion.Checkbox" parent="Zerion.CheckBox" />

	<!-- ================================================================== -->
	<!-- SLIDER & SEEKBAR                                                   -->
	<!-- ================================================================== -->

	<style name="Zerion.Slider" parent="Widget.Material3.Slider">
		<item name="trackColor">@color/zerion_cyan</item>
		<item name="trackColorInactive">@color/zerion_card_bg</item>
		<item name="thumbColor">@android:color/white</item>
		<item name="haloColor">#1AFFFFFF</item>
		<item name="tickColor">@color/zerion_cyan</item>
	</style>

</resources>
