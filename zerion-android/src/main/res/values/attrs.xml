<?xml version="1.0" encoding="utf-8"?>
<resources>

	<attr name="colorControlNormal" format="color" />
	<attr name="selectableItemBackground" format="reference" />

	<attr name="zerionColorBackground" format="color" />
	<attr name="zerionColorSurface" format="color" />
	<attr name="zerionColorSurfaceVariant" format="color" />
	<attr name="zerionColorOnSurface" format="color" />
	<attr name="zerionColorOnSurfaceMuted" format="color" />
	<attr name="zerionColorDivider" format="color" />
	<attr name="zerionColorOutline" format="color" />
	<attr name="zerionColorAccent" format="color" />
	<attr name="zerionColorOnAccent" format="color" />
	<attr name="zerionColorAccentText" format="color" />
	<attr name="zerionColorAccentIcon" format="color" />
	<attr name="zerionColorBubbleIn" format="color" />
	<attr name="zerionColorOnBubbleIn" format="color" />
	<attr name="zerionColorOnBubbleInMuted" format="color" />
	<attr name="zerionColorBubbleInInset" format="color" />
	<attr name="zerionColorBubbleOut" format="color" />
	<attr name="zerionColorOnBubbleOut" format="color" />
	<attr name="zerionColorOnBubbleOutMuted" format="color" />
	<attr name="zerionColorBubbleOutInset" format="color" />
	<attr name="zerionColorDanger" format="color" />
	<attr name="zerionColorDangerText" format="color" />
	<attr name="zerionColorSuccess" format="color" />
	<attr name="zerionColorWarning" format="color" />
	<attr name="zerionColorStatusMuted" format="color" />
	<attr name="zerionColorPresenceOnline" format="color" />
	<attr name="zerionColorPresenceOffline" format="color" />
	<attr name="zerionColorScrim" format="color" />
	<attr name="zerionColorOnScrim" format="color" />
	<attr name="zerionColorMediaBackdrop" format="color" />
	<attr name="zerionColorMessageSelectedOwn" format="color" />
	<attr name="zerionColorMessageSelectedReceived" format="color" />
	<attr name="zerionColorChannelCardSelected" format="color" />
	<attr name="zerionColorSelectionForeground" format="color" />

	<integer name="animationSpeed">@android:integer/config_mediumAnimTime</integer>

	<integer name="splashScreenDuration">500</integer>

	<integer name="text_hyphenation">1</integer>

	<declare-styleable name="ZerionRecyclerView">
		<attr name="scrollToEnd" format="boolean" />
		<attr name="emptyImage" format="integer" />
		<attr name="emptyText" format="string" />
		<attr name="emptyAction" format="string" />
	</declare-styleable>

	<declare-styleable name="AuthorView">
		<attr name="persona" format="enum">
			<enum name="normal" value="0"/>
			<enum name="reblogger" value="1"/>
			<enum name="commenter" value="2"/>
			<enum name="list" value="3"/>
			<enum name="rss_feed" value="4"/>
			<enum name="rss_feed_reblogged" value="5"/>
		</attr>
	</declare-styleable>

	<declare-styleable name="EmojiTextInputView">
		<attr name="textPaddingBottom" format="dimension"/>
		<attr name="textPaddingEnd" format="dimension"/>
		<attr name="maxTextLines" format="integer"/>
	</declare-styleable>

	<declare-styleable name="TextInputView">
		<attr name="hint" format="string"/>
		<attr name="allowEmptyText" format="boolean"/>
	</declare-styleable>

	<declare-styleable name="LargeTextInputView">
		<attr name="buttonText" format="string"/>
		<attr name="maxLines" format="integer"/>
		<attr name="fillHeight" format="boolean" />
	</declare-styleable>

	<declare-styleable name="ZerionButton">
		<attr name="text" format="string" />
		<attr name="buttonStyle" format="reference" />
	</declare-styleable>

</resources>