		<item name="android:textColor">?attr/zerionColorOnBubbleOut</item>
		<item name="android:textColorLink">?attr/zerionColorOnBubbleOut</item>
	</style>

	<style name="TextMessage.Notice">
		<item name="android:textIsSelectable">true</item>
		<item name="android:textAppearance">@style/TextAppearance.Zerion.BodySmall</item>
