	<style name="GroupTrAdminSectionLabel">
		<item name="android:accessibilityHeading">true</item>
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_marginStart">8dp</item>
		<item name="android:layout_marginBottom">8dp</item>
		<item name="android:textColor">?attr/zerionColorOnSurfaceMuted</item>
		<item name="android:textAppearance">@style/TextAppearance.Zerion.Meta.Strong</item>
		<item name="android:letterSpacing">0.08</item>
	</style>

	<style name="GroupTrAdminActionRow">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:minHeight">52dp</item>
		<item name="android:gravity">center_vertical</item>
		<item name="android:orientation">horizontal</item>
		<item name="android:paddingHorizontal">20dp</item>
		<item name="android:paddingVertical">8dp</item>
		<item name="android:background">?attr/selectableItemBackground</item>
		<item name="android:clickable">true</item>
		<item name="android:focusable">true</item>
	</style>

	<style name="GroupTrAdminActionIcon">
		<item name="android:layout_width">22dp</item>
		<item name="android:layout_height">22dp</item>
		<item name="android:layout_marginEnd">18dp</item>
	</style>

	<style name="GroupTrAdminActionText">
		<item name="android:layout_width">0dp</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_weight">1</item>
		<item name="android:textColor">?attr/zerionColorOnSurface</item>
		<item name="android:textAppearance">@style/TextAppearance.Zerion.Body</item>
		<item name="android:breakStrategy">high_quality</item>
		<item name="android:hyphenationFrequency">@integer/text_hyphenation</item>
	</style>

	<style name="GroupTrAdminActionTextDanger" parent="GroupTrAdminActionText">
		<item name="android:textColor">?attr/zerionColorDangerText</item>
	</style>

	<style name="GroupTrAdminDivider">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">0.5dp</item>
		<item name="android:layout_marginStart">60dp</item>
		<item name="android:background">?attr/zerionColorDivider</item>
	</style>

	<style name="GroupTrAdminDetailRow">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:minHeight">36dp</item>
		<item name="android:gravity">center_vertical</item>
		<item name="android:orientation">horizontal</item>
		<item name="android:paddingVertical">6dp</item>
	</style>

	<style name="GroupTrAdminDetailLabel">
		<item name="android:layout_width">0dp</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:layout_weight">1</item>
		<item name="android:textColor">?attr/zerionColorOnSurfaceMuted</item>
		<item name="android:textAppearance">@style/TextAppearance.Zerion.BodySmall</item>
	</style>

	<style name="GroupTrAdminDetailValue">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:textColor">?attr/zerionColorOnSurface</item>
		<item name="android:textAppearance">@style/TextAppearance.Zerion.BodySmall</item>
	</style>

	<style name="ZerionToolbar" parent="Widget.Material3.Toolbar">
		<item name="android:background">?attr/zerionColorBackground</item>
		<item name="titleTextColor">?attr/zerionColorOnSurfaceMuted</item>
		<item name="subtitleTextColor">?attr/zerionColorOnSurfaceMuted</item>
		<item name="titleTextAppearance">@style/TextAppearance.Zerion.ToolbarTitle</item>
		<item name="android:theme">@style/ZerionToolbarTheme</item>
		<item name="popupTheme">@style/PopupMenu</item>
	</style>

	<style name="TextAppearance.Zerion.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
		<item name="android:fontFamily">@font/bricolage_grotesque</item>
		<item name="fontFamily">@font/bricolage_grotesque</item>
		<item name="android:textFontWeight">500</item>
	</style>

	<style name="ZerionToolbarTheme">
		<item name="colorControlNormal">@color/zerion_text_primary</item>
		<item name="actionOverflowButtonStyle">@style/OverflowButtonStyle</item>
	</style>

	<style name="Zerion.ActionButton.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
		<item name="android:minWidth">48dp</item>
		<item name="android:minHeight">48dp</item>
	</style>

	<style name="OverflowButtonStyle" parent="Zerion.ActionButton.Overflow">
		<item name="android:tint">@color/zerion_text_primary</item>
	</style>

	<style name="Zerion.SelectionBar" parent="Widget.Material3.ActionMode">
		<item name="background">?attr/zerionColorSurface</item>
		<item name="backgroundSplit">?attr/zerionColorSurface</item>
		<item name="closeItemLayout">@layout/view_selection_close</item>
	</style>

	<style name="ThemeOverlay.Zerion.SelectionMenu" parent="">
		<item name="colorSurfaceContainer">?attr/zerionColorSurfaceVariant</item>
		<item name="colorOnSurface">?attr/zerionColorOnSurface</item>
		<item name="android:textColorPrimary">?attr/zerionColorOnSurface</item>
	</style>

	<style name="PopupMenu" parent="">
		<item name="android:colorBackground">@color/zerion_card_bg</item>
		<item name="android:textColor">@color/zerion_text_primary</item>
		<item name="android:textColorPrimary">@color/zerion_text_primary</item>
		<item name="android:textColorSecondary">@color/zerion_text_secondary</item>
		<item name="colorSurface">@color/zerion_card_bg</item>
		<item name="colorOnSurface">@color/zerion_text_primary</item>
	</style>

	<style name="ZerionButton" parent="Widget.Material3.Button">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:textSize">@dimen/text_size_medium</item>
		<item name="android:padding">@dimen/margin_large</item>
		<item name="android:minHeight">@dimen/button_size</item>
		<item name="cornerRadius">6dp</item>
	</style>

	<style name="ZerionButtonFlat" parent="Widget.Material3.Button.TextButton">
		<item name="android:textSize">@dimen/text_size_medium</item>
		<item name="android:hyphenationFrequency">@integer/text_hyphenation</item>
	</style>

	<style name="ZerionButtonFlat.Negative" parent="ZerionButtonFlat">
		<item name="android:textColor">@color/zerion_button_text_negative</item>
		<item name="iconTint">@color/zerion_button_text_negative</item>
	</style>

	<style name="ZerionButtonFlat.Positive" parent="ZerionButtonFlat">
		<item name="android:textColor">@color/zerion_button_text_positive</item>
		<item name="iconTint">@color/zerion_button_text_positive</item>
	</style>

	<style name="ZerionButtonFlat.Neutral" parent="ZerionButtonFlat">
		<item name="android:textColor">@color/zerion_button_text_neutral</item>
		<item name="iconTint">@color/zerion_button_text_neutral</item>
	</style>

	<style name="ZerionButtonFlat.Positive.Tiny" parent="ZerionButtonFlat.Positive">
		<item name="android:textSize">@dimen/text_size_tiny</item>
		<item name="android:padding">@dimen/margin_medium</item>
		<item name="android:minWidth">@dimen/button_size</item>
	</style>

	<style name="ZerionButtonOutline" parent="Widget.Material3.Button.OutlinedButton">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:textSize">@dimen/text_size_medium</item>
		<item name="android:padding">@dimen/margin_large</item>
		<item name="android:backgroundTint">@color/window_background</item>
		<item name="android:minHeight">@dimen/button_size</item>
		<item name="cornerRadius">6dp</item>
	</style>

	<style name="ZerionButtonOutline.Negative" parent="ZerionButtonOutline">
		<item name="android:textColor">@color/zerion_button_text_negative</item>
	</style>

	<style name="ZerionButtonOutline.Positive" parent="ZerionButtonOutline">
		<item name="android:textColor">@color/zerion_button_text_positive</item>
	</style>

	<style name="ZerionButtonOutline.Neutral" parent="ZerionButtonOutline">
		<item name="android:textColor">@color/zerion_button_text_neutral</item>
	</style>

	<style name="Zerion.EditText" parent="Widget.AppCompat.EditText">
		<item name="android:background">@android:color/transparent</item>
		<item name="android:textColor">@color/zerion_text_primary</item>
		<item name="android:textColorHint">@color/zerion_hint</item>
		<item name="android:padding">12dp</item>
	</style>

	<style name="Divider">
		<item name="android:background">?attr/zerionColorDivider</item>
	</style>

	<style name="Divider.Horizontal" parent="Divider">
		<item name="android:layout_width">match_parent</item>
		<item name="android:layout_height">1px</item>
	</style>

	<style name="CircularProgress" parent="Widget.Material3.CircularProgressIndicator">
		<item name="android:indeterminate">true</item>
		<item name="indicatorColor">@color/zerion_cyan</item>
	</style>

	<style name="CircularProgress.Large" parent="Widget.Material3.CircularProgressIndicator">
		<item name="android:indeterminate">true</item>
		<item name="indicatorColor">@color/zerion_cyan</item>
		<item name="indicatorSize">76dp</item>
	</style>


	<style name="ZerionAvatar">
		<item name="shapeAppearanceOverlay">@style/ShapeAppearance.Zerion.Circle</item>
	</style>

	<style name="ShapeAppearance.Zerion.Circle" parent="">
