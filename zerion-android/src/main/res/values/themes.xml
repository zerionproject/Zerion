<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

	<style name="ZerionTheme" parent="Theme.Material3.Dark">
		<item name="colorPrimary">@color/zerion_cyan</item>
		<item name="colorOnPrimary">@android:color/white</item>
		<item name="colorPrimaryContainer">@color/zerion_card_bg</item>
		<item name="colorOnPrimaryContainer">@android:color/white</item>
		<item name="colorSecondary">@color/zerion_deep_blue</item>
		<item name="colorOnSecondary">@android:color/white</item>
		<item name="colorTertiary">@color/zerion_aqua</item>
		<item name="colorOnTertiary">@android:color/white</item>
		<item name="colorTertiaryContainer">@color/zerion_card_bg</item>
		<item name="colorOnTertiaryContainer">@color/zerion_cyan</item>
		<item name="android:colorBackground">@color/zerion_dark_bg</item>
		<item name="colorOnBackground">@android:color/white</item>
		<item name="colorSurface">@color/zerion_card_bg</item>
		<item name="colorOnSurface">@android:color/white</item>
		<item name="colorSurfaceDim">@color/zerion_dark_bg</item>
		<item name="colorError">@color/zerion_error_red</item>
		<item name="android:statusBarColor">@color/zerion_dark_bg</item>
		<item name="android:navigationBarColor">@color/zerion_dark_bg</item>

		<item name="android:windowBackground">@color/zerion_dark_bg</item>
		<item name="android:textColor">@android:color/white</item>
		<item name="android:textColorPrimary">@android:color/white</item>
		<item name="android:textColorSecondary">#B3FFFFFF</item>
		<item name="android:textColorLink">@color/zerion_cyan</item>
		<item name="android:windowAnimationStyle">@style/ActivityAnimation</item>
		<item name="windowActionModeOverlay">true</item>
		<item name="toolbarStyle">@style/ZerionToolbar</item>
		<item name="alertDialogTheme">@style/ZerionDialogTheme.Neutral</item>
		<item name="preferenceTheme">@style/PreferenceThemeOverlay.v14</item>

		<!-- Set toolbar icon colors to Zerion cyan for unified look -->
		<item name="colorControlNormal">@color/zerion_cyan</item>
		<item name="colorControlActivated">@color/zerion_cyan</item>
		<item name="colorControlHighlight">@color/zerion_cyan</item>
		<item name="selectableItemBackground">?android:attr/selectableItemBackground</item>
		<item name="android:editTextStyle">@style/Zerion.EditText</item>
		<item name="android:listDivider">@android:color/transparent</item>
		<item name="android:divider">@android:color/transparent</item>

		<item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
	</style>

	<style name="ZerionTheme.NoActionBar" parent="ZerionTheme">
		<item name="windowActionBar">false</item>
		<item name="windowNoTitle">true</item>
		<item name="toolbarStyle">@style/ZerionToolbar</item>
	</style>

	<style name="ZerionTheme.ActionBarOverlay" parent="ZerionTheme.NoActionBar">
		<item name="android:windowActionBarOverlay">true</item>
	</style>

	<style name="ActivityAnimation" parent="@android:style/Animation.Activity">
		<item name="android:activityOpenEnterAnimation">@anim/screen_new_in</item>
		<item name="android:activityOpenExitAnimation">@anim/screen_old_out</item>
		<item name="android:activityCloseEnterAnimation">@anim/screen_old_in</item>
		<item name="android:activityCloseExitAnimation">@anim/screen_new_out</item>
	</style>

	<style name="ZerionDialogTheme" parent="Theme.Material3.Dark.Dialog">
		<item name="colorPrimary">@color/zerion_cyan</item>
		<item name="colorSurface">@color/zerion_card_bg</item>
		<item name="colorOnSurface">@android:color/white</item>
		<item name="android:colorBackground">@color/zerion_card_bg</item>
		<item name="buttonBarPositiveButtonStyle">@style/ZerionButtonFlat.Positive</item>
		<item name="buttonBarNeutralButtonStyle">@style/ZerionButtonFlat.Neutral</item>
		<item name="buttonBarNegativeButtonStyle">@style/ZerionButtonFlat.Negative</item>
		<item name="android:textColor">@android:color/white</item>
		<item name="android:textColorPrimary">@android:color/white</item>
		<item name="android:textColorLink">@color/zerion_cyan</item>
		<item name="android:windowBackground">@color/zerion_card_bg</item>
		<item name="android:windowAnimationStyle">@style/DialogAnimation</item>
		<item name="android:filterTouchesWhenObscured">true</item>
	</style>

	<style name="ZerionFullScreenDialogTheme" parent="ZerionDialogTheme">
		<item name="android:windowIsFloating">false</item>
		<item name="android:windowAnimationStyle">@style/FullScreenDialogAnimation</item>
	</style>

	<style name="FullScreenDialogAnimation" parent="@android:style/Animation.Activity">
		<item name="android:windowEnterAnimation">@anim/step_next_in</item>
		<item name="android:windowExitAnimation">@anim/step_next_out</item>
	</style>

	<!-- Use this with care. Only used for the screen filter warning dialog -->
	<style name="ZerionDialogThemeNoFilter" parent="ZerionDialogTheme">
		<item name="android:filterTouchesWhenObscured">false</item>
	</style>

	<!-- Uses neutral colors for the buttons -->
	<style name="ZerionDialogTheme.Neutral" parent="ZerionDialogTheme">
		<item name="buttonBarPositiveButtonStyle">@style/ZerionButtonFlat.Neutral</item>
		<item name="buttonBarNeutralButtonStyle">@style/ZerionButtonFlat.Neutral</item>
		<item name="buttonBarNegativeButtonStyle">@style/ZerionButtonFlat.Neutral</item>
	</style>

	<style name="DialogAnimation" parent="@android:style/Animation.Dialog">
		<item name="android:windowEnterAnimation">@anim/fade_in</item>
		<item name="android:windowExitAnimation">@anim/fade_out</item>
	</style>

	<style name="OnboardingDialogTheme" parent="ZerionDialogTheme">
		<item name="android:background">@color/zerion_card_bg</item>
		<item name="android:textColorPrimary">@android:color/white</item>
		<item name="colorSurface">@color/zerion_card_bg</item>
	</style>

	<style name="TranslucentTheme" parent="Theme.Material3.DayNight.NoActionBar">
		<item name="android:colorBackgroundCacheHint">@null</item>
		<item name="android:windowAnimationStyle">@android:style/Animation</item>
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:windowContentOverlay">@null</item>
		<item name="android:windowIsTranslucent">true</item>
		<item name="android:windowNoTitle">true</item>
	</style>

	<!-- Preference text colors for Settings -->
	<style name="Preference.Zerion" parent="Preference">
		<item name="android:textColor">#FFFFFF</item>
	</style>

	<style name="PreferenceThemeOverlay.v14" parent="PreferenceThemeOverlay.v14.Material">
		<item name="android:textColorPrimary">#FFFFFF</item>
		<item name="android:textColorSecondary">#8A8FA6</item>
		<item name="colorAccent">@color/zerion_text_secondary</item>
		<item name="colorControlNormal">@android:color/transparent</item>
		<item name="colorControlActivated">@android:color/transparent</item>
		<item name="android:divider">@android:color/transparent</item>
		<item name="preferenceStyle">@style/Zerion.Preference</item>
		<item name="preferenceCategoryStyle">@style/Zerion.PreferenceCategory</item>
		<item name="android:listDivider">@android:color/transparent</item>
		<item name="android:dividerHeight">0dp</item>
	</style>

	<!-- Borderless preference styles -->
	<style name="Zerion.Preference" parent="Preference.Material">
		<item name="android:background">@drawable/settings_item_background</item>
		<item name="android:layout">@layout/preference_material</item>
	</style>

	<style name="Zerion.PreferenceCategory" parent="Preference.Category.Material">
		<item name="android:background">@android:color/transparent</item>
		<item name="android:layout">@layout/preference_category_material</item>
	</style>

</resources>